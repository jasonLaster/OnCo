{"schemaVersion":1,"nct":"NCT00149201","source":"https://clinicaltrials.gov/study/NCT00149201","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT00149201","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:51:57.214Z","studySha256":"868f91caed2b53f80366d3821a1ffe46065e1353ec9d2d422026f98b34875faa","study":{"protocolSection":{"identificationModule":{"nctId":"NCT00149201","briefTitle":"A Study of 5-FU Versus MTX+5-FU in Gastric Cancer With Peritoneal Metastasis","officialTitle":"Randomized Phase III Study of 5-FU Continuous Infusion (5FUci) Versus MTX+5-FU Sequential Therapy (MF) in Gastric Cancer With Peritoneal Metastasis (JCOG0106-MF, MF/5FU)"},"statusModule":{"statusVerifiedDate":"2009-02","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2002-11"},"primaryCompletionDateStruct":{"date":"2008-04","type":"ACTUAL"},"completionDateStruct":{"date":"2008-04","type":"ACTUAL"},"studyFirstSubmitDate":"2005-09-07","studyFirstSubmitQcDate":"2005-09-07","studyFirstPostDateStruct":{"date":"2005-09-08","type":"ESTIMATED"},"lastUpdateSubmitDate":"2009-02-02","lastUpdatePostDateStruct":{"date":"2009-02-03","type":"ESTIMATED"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Japan Clinical Oncology Group","class":"OTHER"},"collaborators":[{"name":"Ministry of Health, Labour and Welfare, Japan","class":"OTHER_GOV"}]},"descriptionModule":{"briefSummary":"To develop effective chemotherapy regimen against gastric cancer with peritoneal metastasis","detailedDescription":"Peritoneal metastasis is common in advanced gastric cancer and is considered an incurable disease state. Peritoneal metastasis may cause serious complications, such as intestinal obstruction, massive ascites, and hydronephrosis associated with the clinical presentation of abdominal pain and fullness, vomiting, constipation, malnutrition and renal dysfunction.5-FU continuous infusion remains the mainstay for chemotherapy against gastric cancer. On the other, sequential MTX+5-FU was reported to be effective in advanced gastric cancer with peritoneal metastasis in some phase II studies. Therefore, the randomized phase III study of 5-FU versus sequential MTX+5-FU in gastric cancer with peritoneal metastasis was conducted."},"conditionsModule":{"conditions":["Gastric Cancer","Neoplasm Metastasis"],"keywords":["gastric cancer","peritoneal metastasis","randomized trial","5-FU","MTX"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":160}},"armsInterventionsModule":{"interventions":[{"type":"DRUG","name":"5-FU continuous infusion"},{"type":"DRUG","name":"MTX + 5-FU sequential therapy"}]},"outcomesModule":{"primaryOutcomes":[{"measure":"overall survival"}],"secondaryOutcomes":[{"measure":"oral intake"},{"measure":"toxicity"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n1. histologic confirmation of gastric adenocarcinoma\n2. inoperable metastatic disease or recurrent metastatic disease after surgery\n3. disease with peritoneal metastasis\n4. 20 years or more but less than 75 years\n5. performance status 2 or less on the Eastern Cooperative Oncology Group scale\n6. no prior treatment for gastric carcinoma except for surgery and adjuvant chemotherapy\n7. no prior chemotherapy or radiotherapy for other disease except for gastric cancer\n8. adequate bone marrow function, adequate liver function, and adequate renal function\n9. no prior transfusion for anemia\n10. provision of written informed consent\n\nExclusion Criteria:\n\n1. Massive pleural effusion\n2. brain metastasis with symptoms\n3. severe diarrhea\n4. other severe medical conditions (infection, diabetes, hypertension, acute myocardial infarction, unstable angina, liver cirrhosis, intestinal pneumonia, pulmonary fibrosis)\n5. other active malignancies","healthyVolunteers":false,"sex":"ALL","minimumAge":"20 Years","maximumAge":"75 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"Aichi Cancer Center Hospital","city":"1-1,Kanokoden,Chikusa-ku,Nagoya","state":"Aichi-ken","zip":"464-8681","country":"Japan","geoPoint":{"lat":35.18147,"lon":136.90641}},{"facility":"Aichi Cancer Center,Aichi Hospital","city":"18,Kuriyado,Kake-machi,Okazaki","state":"Aichi-ken","zip":"444-0011","country":"Japan","geoPoint":{"lat":34.95,"lon":137.16667}},{"facility":"Nagoya Medical Center","city":"4-1-1,Sannomaru,Naka-ku,Nagoya","state":"Aichi-ken","zip":"460-0001","country":"Japan"},{"facility":"Aomori Prefectural Central Hospital","city":"2-1-1,Higashitsukurimiti,Aomori","state":"Aomori","zip":"030-0911","country":"Japan","geoPoint":{"lat":40.81667,"lon":140.73333}},{"facility":"National Cancer Center Hospital East","city":"6-5-1,Kashiwanoha,Kashiwa","state":"Chiba","zip":"277-8577","country":"Japan"},{"facility":"Chiba Cancer Center Hospital","city":"666-2,Nitona-cho,Chuo-ku,Chiba","state":"Chiba","zip":"260-8717","country":"Japan","geoPoint":{"lat":35.6,"lon":140.11667}},{"facility":"Asahi General Hospital","city":"I-1326,Asahi","state":"Chiba","zip":"289-2511","country":"Japan","geoPoint":{"lat":35.71667,"lon":140.65}},{"facility":"National Hospital Organization Shikoku Cancer Center","city":"13,Horinouchi,Matsuyama","state":"Ehime","zip":"790-0007","country":"Japan"},{"facility":"Kyushu University Hospital","city":"3-1-1,Maidashi,Higashi-ku","state":"Fukuoka","zip":"812-8582","country":"Japan","geoPoint":{"lat":33.79475,"lon":130.67647}},{"facility":"National Kyushu Cancer Center","city":"3-1-1,Notame,Minami-ku,Fukuoka","state":"Fukuoka","zip":"811-1395","country":"Japan"},{"facility":"Federation of national public service personnel mutual aid associations Tonan Hospital","city":"Kita 1 Nishi 6,Chuo-ku,Sapporo","state":"Hokkaido","zip":"060-0001","country":"Japan"},{"faci