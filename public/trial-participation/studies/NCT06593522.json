{"schemaVersion":1,"nct":"NCT06593522","source":"https://clinicaltrials.gov/study/NCT06593522","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT06593522","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:54:49.791Z","studySha256":"043930c5a57684b9978d7b18f35a60807cc95113f5c4d7ff7f00d5e29bbd818e","study":{"protocolSection":{"identificationModule":{"nctId":"NCT06593522","briefTitle":"A Phase 2 Study of Anvumetostat in Participants With MTAP-deleted Advanced NSCLC (MTAPESTRY 201)","officialTitle":"A Phase 2 Study Evaluating the Efficacy, Safety, Tolerability, and Pharmacokinetics of Anvumetostat in Subjects With Methylthioadenosine Phosphorylase (MTAP)-Deleted Previously Treated Advanced Non-Small Cell Lung Cancer (NSCLC)"},"statusModule":{"statusVerifiedDate":"2026-05","overallStatus":"ACTIVE_NOT_RECRUITING","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2024-12-26","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2026-10-31","type":"ESTIMATED"},"completionDateStruct":{"date":"2026-11-30","type":"ESTIMATED"},"studyFirstSubmitDate":"2024-09-03","studyFirstSubmitQcDate":"2024-09-10","studyFirstPostDateStruct":{"date":"2024-09-19","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-05-26","lastUpdatePostDateStruct":{"date":"2026-05-28","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Amgen","class":"INDUSTRY"}},"descriptionModule":{"briefSummary":"The main objective of the study is to characterize safety and efficacy of 2 dose levels of anvumetostat by investigator, and to evaluate anvumetostat monotherapy efficacy by Blinded Independent Central Review (BICR)."},"conditionsModule":{"conditions":["MTAP-deleted NSCLC"],"keywords":["Oncology","anvumetostat"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE2"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"SEQUENTIAL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":61,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Part 1: Dose Evaluation","type":"EXPERIMENTAL","description":"Participants will be randomized to receive one of 2 active dose levels of anvumetostat orally (PO) daily (QD) in 28 days cycles. Part 1 of the study will determine the recommended phase 2 dose (RP2D).","interventionNames":["Drug: anvumetostat"]},{"label":"Part 2: Dose Expansion","type":"EXPERIMENTAL","description":"Participants will receive anvumetostat PO QD in 28-day cycles at the RP2D.","interventionNames":["Drug: anvumetostat"]}],"interventions":[{"type":"DRUG","name":"anvumetostat","description":"Film-coated tablet","armGroupLabels":["Part 1: Dose Evaluation","Part 2: Dose Expansion"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Objective Response (OR) per RECIST 1.1","timeFrame":"Up to 35 months"},{"measure":"Objective response (OR) Measured by Computed Tomography (CT) or Magnetic Resonance Imaging (MRI) and Assessed per Response Evaluation Criteria in Solid Tumors v1.1 (RECIST 1.1)","timeFrame":"Up to 35 months"},{"measure":"Number of Participants Experiencing Treatment-emergent Adverse Events (TEAEs)","timeFrame":"Up to 35 months"},{"measure":"Number of Participants Experiencing Events of Interest (EOIs)","timeFrame":"Up to 35 months"},{"measure":"Maximum Concentration (Cmax) of anvumetostat","timeFrame":"Cycle 1: Day 1 and Day 15 pre-dose, 0.5 hours, 1 hour, 2 hours, 4 hours, and 6 hours post-dose; Cycle 2: Day 1 and Day 15 pre-dose; Cycles 3-5: Day 1 pre-dose"},{"measure":"Time to Cmax (Tmax) of anvumetostat","timeFrame":"Cycle 1: Day 1 and Day 15 pre-dose, 0.5 hours, 1 hour, 2 hours, 4 hours, and 6 hours post-dose; Cycle 2: Day 1 and Day 15 pre-dose; Cycles 3-5: Day 1 pre-dose"},{"measure":"Area Under The Concentration-time Curve (AUC) of anvumetostat","timeFrame":"Cycle 1: Day 1 and Day 15 pre-dose, 0.5 hours, 1 hour, 2 hours, 4 hours, and 6 hours post-dose; Cycle 2: Day 1 and Day 15 pre-dose; Cycles 3-5: Day 1 pre-dose"}],"secondaryOutcomes":[{"measure":"Disease Control (DC) by BICR","timeFrame":"Up to 35 months"},{"measure":"Duration of Response (DOR) by BICR","timeFrame":"Up to 35 months"},{"measure":"Time to Response (TTR) by BICR","timeFrame":"Up to 35 months"},{"measure":"Progression-free Survival (PFS) by BICR","timeFrame":"Up to 35 months"},{"measure":"OR by Investigator's Assessment","timeFrame":"Up to 35 months"},{"measure":"DC by Investigator's Assessment","timeFrame":"Up to 35 months"},{"measure":"DOR by Investigator's Assessment","timeFrame":"Up to 35 months"},{"measure":"TTR by Investigator's Assessment","timeFrame":"Up to 35 months"},{"measure":"PFS by Investigator's Assessment","timeFrame":"Up to 35 months"},{"measure":"Overall Survival (OS)","timeFrame":"Up to 35 months"},{"measure":"Number of Participants Experiencing TEAEs","timeFrame":"Up to 35 months"},{"measure":"Cmax of anvumetostat","timeFrame":"Cycle 1: Day 1 and Day 15 pre-dose, 0.5 hours, 1 hour, 2 hours, 4 hours, and 6 hours post-dose; Cycle 2: Day 1 and Day 15 pre-dose; Cycles 3-5: Day 1 pre-dose"},{"measure":"Tmax of anvumetostat","timeFrame":"Cycle 1: Day 1 and Day 15 pre-dose, 0.5 hours, 1 hour, 2 hours, 4 hours, and 6 hours post-dose; Cycle 2: Day 1 and Day 15 pre-dose; Cycles 3-5: Day 1 pre-dose"},{"measure":"AUC of anvumetostat","timeFrame":"Cycle 1: Day 1 and Day 15 pre-dose, 0.5 hours, 1 hour, 2 hours, 4 hours, and 6 hours post-dose; Cycle 2: Day 1 and Day 15 pre-dose; Cycles 3-5: Day 1 pre-dose"},{"measure":"Change in Quality of life (QoL) per The European Organization for Research and Treatment of Cancer Quality of life Questionnaire (EORTC QLQ)-C30","timeFrame":"Up to 12 months"},{"measure":"Change in QoL per Quality of Life Questionnaire-Lung Cancer 13 (QLQ LC13)","timeFrame":"Up to 12 months"},{"measure":"Change in QoL per European Quality of Life 5 Dimensions 5 Levels (EQ-5D-5L)","timeFrame":"Up to 12 months"},{"measure":"Overall Health Status per Patient-Reported Outcomes version of the Common Terminology Criteria for Adverse Events (PRO-CTCAE)","timeFrame":"Up to 12 months"},{"measure":"Overall Health Status per The Functional Assessment of Cancer Therapy - General (FACT-G)","timeFrame":"Up to 12 months"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Histologically or cytologically confirmed metastatic or unresectable locally advanced MTAP-deleted (Homozygous deletion of MTAP) NSCLC\n* Participants will have received and progressed or experienced disease recurrence on or after receiving at least 1 prior systemic therapy for locally advanced and unresectable or metastatic disease.\n* Either an archival tissue sample or an archival block must be available.\n* Life expectancy of greater than 3 months, in the opinion of the investigator.\n* Participants who have had brain metastases and have been appropriately treated with radiation therapy or surgery ending at least 14 days before study day 1 are eligible.\n* Participants with untreated asymptomatic brain metastases smaller or equal to 2 cm in size (per lesion if more than one) and not requiring corticosteroid treatment are eligible.\n\nExclusion Criteria:\n\nDisease Related\n\n• Tumors harboring the following mutations amenable to targeted therapies: epidermal growth factor receptor (EGFR), ALK receptor tyrosine kinase (ALK), ROS proto-oncogene 1 (ROS1), neurotrophic tyrosine receptor kinase (NTRK), MET proto-oncogene (MET), B-Raf proto-oncogene (BRAF), RET proto-oncogene (RET), Human epidermal growth factor receptor 2 (HER2/ERBB2), KRAS proto-oncogene G12C (KRAS G12C).\n\nOther Medical Conditions\n\n* Major surgery within 28 days of study day 1.\n* Untreated symptomatic central nervous system (CNS) metastatic disease regardless of size or asymptomatic brain metastases greater than 2 cm per lesion.","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","maximumAge":"99 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facili