{"schemaVersion":1,"nct":"NCT03785249","source":"https://clinicaltrials.gov/study/NCT03785249","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT03785249","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:53:08.563Z","studySha256":"cb8edaa45bda1da60fdf0497f7c2de9089ee4b91f10161a1df3232765d678869","study":{"protocolSection":{"identificationModule":{"nctId":"NCT03785249","briefTitle":"Phase 1/2 Study of MRTX849 in Patients With Cancer Having a KRAS G12C Mutation KRYSTAL-1","officialTitle":"A Phase 1/2 Multiple Expansion Cohort Trial of MRTX849 in Patients With Advanced Solid Tumors With KRAS G12C Mutation KRYSTAL-1"},"statusModule":{"statusVerifiedDate":"2026-07","overallStatus":"ACTIVE_NOT_RECRUITING","expandedAccessInfo":{"hasExpandedAccess":true,"nctId":"NCT05162443","statusForNctId":"APPROVED_FOR_MARKETING"},"startDateStruct":{"date":"2019-01-15","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2026-06-23","type":"ACTUAL"},"completionDateStruct":{"date":"2026-12-31","type":"ESTIMATED"},"studyFirstSubmitDate":"2018-12-18","studyFirstSubmitQcDate":"2018-12-19","studyFirstPostDateStruct":{"date":"2018-12-24","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-07-28","lastUpdatePostDateStruct":{"date":"2026-07-29","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Mirati Therapeutics Inc.","class":"INDUSTRY"}},"descriptionModule":{"briefSummary":"This study will evaluate the safety, tolerability, drug levels, molecular effects, and clinical activity of MRTX849 (adagrasib) in patients with advanced solid tumors that have a KRAS G12C mutation.","detailedDescription":"This study will evaluate the safety, tolerability, pharmacokinetics, metabolites, pharmacodynamics, and clinical activity of MRTX849 (adagrasib) in patients with advanced solid tumors with a KRAS G12C mutation. MRTX849 (adagrasib) is an orally-available small molecule inhibitor of KRAS G12C."},"conditionsModule":{"conditions":["Advanced Cancer","Metastatic Cancer","Malignant Neoplastic Disease"],"keywords":["KRAS","NSCLC","Colorectal Cancer","Colon Cancer","Metastatic Cancer","Pancreatic Cancer","Adagrasib","STK11 mutation","KRAS G12C"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE1","PHASE2"],"designInfo":{"allocation":"NON_RANDOMIZED","interventionModel":"SEQUENTIAL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":731,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Phase 1 Dose Exploration","type":"EXPERIMENTAL","description":"Dose escalation of MRTX849 to determine maximum tolerated dose","interventionNames":["Drug: MRTX849"]},{"label":"Phase 1b Expansion","type":"EXPERIMENTAL","description":"Expansion cohort to ensure sufficient safety experience, pharmacokinetic information, and early evidence of clinical activity of MRTX849 to recommend Phase 2 regimens","interventionNames":["Drug: MRTX849"]},{"label":"Phase 2","type":"EXPERIMENTAL","description":"Separate cohorts of patients stratified by histological diagnosis, prior treatment history or co-mutation status (e.g., STK11) for evaluation of clinical activity of MRTX849","interventionNames":["Drug: MRTX849"]},{"label":"Pilot Phase 1b Combination with Pembrolizumab","type":"EXPERIMENTAL","description":"Phase 1 evaluation of the safety, tolerability, PK and clinical activity of MRTX849 in combination with pembrolizumab in patients with NSCLC","interventionNames":["Drug: MRTX849","Drug: Pembrolizumab"]},{"label":"Pilot Phase 1b Combination with Cetuximab","type":"EXPERIMENTAL","description":"Phase 1 evaluation of the safety, tolerability, PK and clinical activity of MRTX849 in combination with cetuximab in patients with CRC","interventionNames":["Drug: MRTX849","Drug: Cetuximab"]},{"label":"Pilot Phase 1b Combination with Afatinib","type":"EXPERIMENTAL","description":"Phase 1 evaluation of the safety, tolerability, PK and clinical activity of MRTX849 in combination with afatinib in patients with NSCLC","interventionNames":["Drug: MRTX849","Drug: Afatinib"]},{"label":"Phase 2 Combination with Cetuximab","type":"EXPERIMENTAL","description":"Phase 2 evaluation of the clinical activity of MRTX849 in combination with cetuximab in patients with CRC","interventionNames":["Drug: MRTX849","Drug: Cetuximab"]},{"label":"Pilot Phase 1b Combination with Cetuximab in NSCLC","type":"EXPERIMENTAL","description":"Phase 1 evaluation of the safety, tolerability, PK and clinical activity of MRTX849 in combination with cetuximab in patients with NSCLC","interventionNames":["Drug: MRTX849","Drug: Cetuximab"]},{"label":"Pilot Phase 1b Combination with Cetuximab in PDAC","type":"EXPERIMENTAL","description":"Phase 1 evaluation of the safety, tolerability, PK and clinical activity of MRTX849 in combination with cetuximab in patients with pancreatic adenocarcinoma (PDAC)","interventionNames":["Drug: MRTX849","Drug: Cetuximab"]}],"interventions":[{"type":"DRUG","name":"MRTX849","description":"MRTX849 will be administered orally once or twice daily in a continuous regimen","armGroupLabels":["Phase 1 Dose Exploration","Phase 1b Expansion","Phase 2","Phase 2 Combination with Cetuximab","Pilot Phase 1b Combination with Afatinib","Pilot Phase 1b Combination with Cetuximab","Pilot Phase 1b Combination with Cetuximab in NSCLC","Pilot Phase 1b Combination with Cetuximab in PDAC","Pilot Phase 1b Combination with Pembrolizumab"]},{"type":"DRUG","name":"Pembrolizumab","description":"Pembrolizumab is administered as an intravenous infusion once every 3 weeks","armGroupLabels":["Pilot Phase 1b Combination with Pembrolizumab"]},{"type":"DRUG","name":"Cetuximab","description":"Cetuximab will be administered as an intravenous infusion once per week or once every 2 weeks","armGroupLabels":["Phase 2 Combination with Cetuximab","Pilot Phase 1b Combination with Cetuximab","Pilot Phase 1b Combination with Cetuximab in NSCLC","Pilot Phase 1b Combination with Cetuximab in PDAC"]},{"typ