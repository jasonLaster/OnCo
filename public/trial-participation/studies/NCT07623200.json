{"schemaVersion":1,"nct":"NCT07623200","source":"https://clinicaltrials.gov/study/NCT07623200","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT07623200","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:55:51.217Z","studySha256":"18ed0d37a438f83bf5fa45c296de7c450b3ab25426b43ce931a7edac9944d639","study":{"protocolSection":{"identificationModule":{"nctId":"NCT07623200","briefTitle":"A Phase 3 Study of INCA033989 Versus Best Available Therapy in Participants With Essential Thrombocythemia","officialTitle":"A Phase 3, Randomized, Open-Label Study of INCA033989 Versus Best Available Therapy in Participants With Essential Thrombocythemia and a CALR Mutation Previously Treated With Cytoreductive Therapy (EXCALIBUR-ET2)","acronym":"EXCALIBUR-ET2"},"statusModule":{"statusVerifiedDate":"2026-09","overallStatus":"RECRUITING","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2026-09-08","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2029-06-15","type":"ESTIMATED"},"completionDateStruct":{"date":"2030-11-01","type":"ESTIMATED"},"studyFirstSubmitDate":"2026-05-29","studyFirstSubmitQcDate":"2026-05-29","studyFirstPostDateStruct":{"date":"2026-06-03","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-09-11","lastUpdatePostDateStruct":{"date":"2026-09-14","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Incyte Corporation","class":"INDUSTRY"}},"descriptionModule":{"briefSummary":"This study is being conducted to evaluate INCA033989 versus best available therapy in participants with essential thrombocythemia and a CALR mutation previously treated with cytoreductive therapy."},"conditionsModule":{"conditions":["Essential Thrombocythemia"],"keywords":["calreticulin (CALR)","mutCALR"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":426,"type":"ESTIMATED"}},"armsInterventionsModule":{"armGroups":[{"label":"INCA033989","type":"EXPERIMENTAL","description":"Administered intravenous (IV) in accordance with the protocol-defined requirements.","interventionNames":["Drug: INCA033989"]},{"label":"Best Available Therapy (BAT)","type":"EXPERIMENTAL","description":"Best Available Therapy (BAT) will be selected by the investigator.","interventionNames":["Drug: Best Available Treatment"]}],"interventions":[{"type":"DRUG","name":"INCA033989","description":"Administered intravenous (IV) in accordance with the protocol-defined requirements.","armGroupLabels":["INCA033989"]},{"type":"DRUG","name":"Best Available Treatment","description":"Best Available Therapy (BAT) will be selected by the investigator.","armGroupLabels":["Best Available Therapy (BAT)"],"otherNames":["BAT could include:","• HU","• ANA","• PEG interferon alfa-2a","• Ropeginterferon alfa-2b"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Durable clinicohematologic response (DCR)","description":"Normalization of platelet and white blood cell (WBC) counts and absence of disease progression as defined in the protocol.","timeFrame":"Week 24"}],"secondaryOutcomes":[{"measure":"Reduction from baseline in calreticulin exon 9 frameshift mutation(s) (mutCLAR) variant allele frequency (VAF)","description":"Reduction in mutCALR VAF as defined in the protocol.","timeFrame":"Week 24"},{"measure":"Durable clinicohematologic response (DCR)","description":"Normalization of platelet and white blood cell (WBC) counts and absence of disease progression as defined in the protocol.","timeFrame":"Week 48"},{"measure":"Durable partial clinicohematologic response (DPR)","description":"Improvement of platelet and white blood cell (WBC) counts and absence of disease progression as defined in the protocol.","timeFrame":"Week 24"},{"measure":"Durable partial clinicohematologic response (DPR)","description":"Improvement of platelet and white blood cell (WBC) counts and absence of disease progression as defined in the protocol.","timeFrame":"Week 48"},{"measure":"Longest duration of complete hematologic response (CHR)","description":"Longest time from documented CHR until the loss of CHR as defined in the protocol.","timeFrame":"Up to Week 48"},{"measure":"Number of Participants with Treatment Emergent Adverse Events (TEAE)","description":"Defined as any adverse event occurring after the first dose of study drug until up to 60 days after the last dose of study drug.","timeFrame":"Up to Week 48 and 60 days after last dose"},{"measure":"TEAEs leading to dose interruptions, dose reductions or discontinuation of study treatment","description":"TEAEs leading to dose interruptions, dose reductions or discontinuation of study treatment.","timeFrame":"Up to Week 48 and 60 days after last dose"},{"measure":"Number of participants with a reduction in mutCALR VAF","description":"Number of participants with a reduction in mutCALR VAF as defined in the protocol.","timeFrame":"Week 24 and Week 48"},{"measure":"Molecular response","description":"Overall reduction in mutCALR VAF as defined in the protocol.","timeFrame":"Week 24 and Week 48"},{"measure":"Change from baseline in Myeloproliferative Neoplasm Symptom Assessment Form (MPN-SAF) total symptom score (TSS)","description":"Defined as the proportion of participants who achieve a protocol defined reduction in TSS.","timeFrame":"Up to Week 48"},{"measure":"Change from baseline in Brief Fatigue Inventory (BFI) fatigue score","description":"The BFI is a 9 item scored from 0 (no fatigue) -10 (as bad as you can imagine), items are averaged with total score from 0-10, with higher score indicating more fatigue.","timeFrame":"Up to Week 48"},{"measure":"Patient Global Impression of Change (PGIC) score","description":"The PGIC is based on a 7-point scale and the participant will rate each question from the start of treatment as 1-very much improved, 2-much improved, 3-minimally improved, 4-no change, 5-minimally worse, 6-much worse, and 7-very much worse.","timeFrame":"Up to Week 48"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Confirmed diagnosis of high-risk ET.\n* Presence of mutCALR.\n* Prior treatment with at least 1 cytoreductive therapy.\n\nExclusion Criteria:\n\n* Presence of any hematologic malignancy other than ET.\n* Major bleeding or thrombosis within the last 3 months prior to study enrollment.\n* Any prior allogenic or autologous stem-cell transplantation.\n* Unresolved toxicity ≥ Grade 2 from previous therapy except for stable chronic toxicities (Grade 2) not expected to resolve, such as stable Grade 2 peripheral neuropathy.\n* Prior nonhematologic malignancy except for the following: Malignancy treated with curative intent and with no evidence of active disease for more than 2 years before screening. Adequately treated carcinoma in situ without current evidence of disease.\n\nOther protocol-defined Inclusion/Exclusion Criteria apply.","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"Banner Md Anderson Cancer Center","status":"NOT_YET_RECRUITING","city":"Gilbert","state":"Arizona","zip":"85234","country":"United States","geoPoint":{"lat":33.35283,"lon":-111.78903}},{"facility":"City of Hope Medical Center","status":"NOT_YET_RECRUITING","city":"Duarte","state":"California","zip":"91010","country":"United States","geoPoint":{"lat":34.13945,"lon":-117.97729}},{"facility":"Marin Cancer Care","status":"RECRUITING","city":"Greenbrae","state":"California","zip":"94904","country":"United States","geoPoint":{"lat":37.94854,"lon":-122.5247}},{"facility":"University of California, Los Angeles Medical Center","status":"NOT_YET_RECRUITING","city":"Los Angeles","state":"California","zip":"90095","country":"United States","geoPoint":{"lat":34.05223,"lon":-118.24368}},{"facility":"Stanford Cancer Center","status":"NOT_