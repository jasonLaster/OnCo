{"schemaVersion":1,"nct":"NCT00529503","source":"https://clinicaltrials.gov/study/NCT00529503","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT00529503","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:52:07.501Z","studySha256":"8bd582beeb40e2a1e0680420d7c2c082bbb74784ed90a91d3b88bcae515f4683","study":{"protocolSection":{"identificationModule":{"nctId":"NCT00529503","briefTitle":"A Randomized Phase IIb Placebo-Controlled Study of R-ICE Chemotherapy With and Without SGN-40 for Patients With DLBCL","officialTitle":"A Randomized Phase IIb Placebo-controlled Study of R-ICE Chemotherapy With and Without SGN-40 (Anti-CD40 Humanized Monoclonal Antibody) for Second-line Treatment of Patients With Diffuse Large B-Cell Lymphoma (DLBCL)"},"statusModule":{"statusVerifiedDate":"2015-02","overallStatus":"TERMINATED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2007-09"},"primaryCompletionDateStruct":{"date":"2009-12","type":"ACTUAL"},"completionDateStruct":{"date":"2011-05","type":"ACTUAL"},"studyFirstSubmitDate":"2007-09-11","studyFirstSubmitQcDate":"2007-09-12","studyFirstPostDateStruct":{"date":"2007-09-14","type":"ESTIMATED"},"dispFirstSubmitDate":"2011-06-16","dispFirstSubmitQcDate":"2011-06-16","dispFirstPostDateStruct":{"date":"2011-06-27","type":"ESTIMATED"},"lastUpdateSubmitDate":"2015-02-06","lastUpdatePostDateStruct":{"date":"2015-02-25","type":"ESTIMATED"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Seagen Inc.","class":"INDUSTRY"},"collaborators":[{"name":"Genentech, Inc.","class":"INDUSTRY"}]},"descriptionModule":{"briefSummary":"This is a randomized trial to estimate the activity of R-ICE plus SGN-40 vs. R-ICE plus placebo in patients with DLBCL. The study will assess safety and tolerability and will measure any additional clinical benefit observed in patients receiving SGN-40."},"conditionsModule":{"conditions":["Lymphoma, Large B-Cell, Diffuse","Lymphoma, Non-Hodgkin"],"keywords":["Lymphoproliferative Disorders","Lymphoma","Antigens, CD40","Antibody, Monoclonal","Combined Modality Therapy","Lymphoma, Large B-Cell, Diffuse","Lymphoma, Non-Hodgkin","Hematologic Diseases","Immunoproliferative Disorders","Lymphatic Diseases"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE2"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"QUADRUPLE","whoMasked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]}},"enrollmentInfo":{"count":151,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"1","type":"EXPERIMENTAL","description":"SGN-40, rituximab, etoposide, carboplatin, ifosfamide","interventionNames":["Drug: SGN-40","Drug: rituximab","Drug: etoposide","Drug: carboplatin","Drug: ifosfamide"]},{"label":"2","type":"PLACEBO_COMPARATOR","description":"placebo, rituximab, etoposide, carboplatin, ifosfamide","interventionNames":["Drug: placebo","Drug: rituximab","Drug: etoposide","Drug: carboplatin","Drug: ifosfamide"]}],"interventions":[{"type":"DRUG","name":"SGN-40","description":"2-8 mg/kg IV. Cycle 1: Days -1, 3, 8, 15; Cycles 2, 3: Days 1, 8, 15.","armGroupLabels":["1"],"otherNames":["dacetuzumab"]},{"type":"DRUG","name":"placebo","description":"Volume as equivalent to corresponding SGN 40 dose IV. Cycle 1: Days -1, 3, 8, 15. Cycles 2, 3: Days 1, 8, 15.","armGroupLabels":["2"]},{"type":"DRUG","name":"rituximab","description":"375 mg/m2 IV. Cycle 1: Day -2; Cycles 2, 3: Day 1","armGroupLabels":["1","2"],"otherNames":["Rituxan"]},{"type":"DRUG","name":"etoposide","description":"100 mg/m2 IV. Cycles 1-3: Days 1, 2 and 3.","armGroupLabels":["1","2"],"otherNames":["Toposar, Vepesid"]},{"type":"DRUG","name":"carboplatin","description":"AUC=5 mg/mL min IV. Cycles 1-3: Day 2.","armGroupLabels":["1","2"],"otherNames":["Paraplatin"]},{"type":"DRUG","name":"ifosfamide","description":"5 g/m2 24 hr. IV infusion. Cycles 1-3: Day2.","armGroupL