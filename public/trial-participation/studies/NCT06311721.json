IGATOR"]}},"enrollmentInfo":{"count":315,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"ABP 234","type":"EXPERIMENTAL","description":"Part 1: Participants will receive ABP 234 followed by pemetrexed administered with platinum-based chemotherapy (cisplatin or carboplatin). Part 2: Participants will receive ABP 234 followed by pemetrexed.","interventionNames":["Drug: ABP 234"]},{"label":"Pembrolizumab (US)","type":"EXPERIMENTAL","description":"Part 1: Participants will receive FDA-licensed pembrolizumab followed by pemetrexed administered with platinum-based chemotherapy (cisplatin or carboplatin). Part 2: Participants will receive FDA-licensed pembrolizumab followed by pemetrexed.","interventionNames":["Drug: Pembrolizumab (US)"]},{"label":"Pembrolizumab (EU)","type":"EXPERIMENTAL","description":"Part 1: Participants will receive EU-approved pembrolizumab followed by pemetrexed administered with platinum-based chemotherapy (cisplatin or carboplatin). Part 2: Participants will receive EU-approved pembrolizumab followed by pemetrexed.","interventionNames":["Drug: Pembrolizumab (EU)"]}],"interventions":[{"type":"DRUG","name":"ABP 234","description":"Intravenous administration","armGroupLabels":["ABP 234"]},{"type":"DRUG","name":"Pembrolizumab (US)","description":"Intravenous administration","armGroupLabels":["Pembrolizumab (US)"],"otherNames":["Keytruda®"]},{"type":"DRUG","name":"Pembrolizumab (EU)","description":"Intravenous administration","armGroupLabels":["Pembrolizumab (EU)"],"otherNames":["Keytruda®"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Area under the serum concentration-time curve (AUC) from time 0 to 21 days (AUC21d) of ABP 234","timeFrame":"21 days"},{"measure":"AUC21d of pembrolizumab (US)","timeFrame":"21 days"},{"measure":"AUC21d of pembrolizumab (EU)","timeFrame":"21 days"},{"measure":"AUC at steady state between Week 16 and Week 19 (AUCtau_ss) of ABP 234","timeFrame":"Week 16 through Week 19"},{"measure":"AUCtau_ss of p