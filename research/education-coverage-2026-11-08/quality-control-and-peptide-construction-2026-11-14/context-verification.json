      "group": "potency",
      "textLabels": [
        "What does this test establish?",
        "Three questions about one biological product",
        "1  Identity / expression",
        "ID",
        "Right product?",
        "Receptor present?",
        "Useful attributes.",
        "These do not establish tested function.",
        "2  Product-relevant activity",
        "Product + target",
        "Target only",
        "Compare the activity readout.",
        "Keep background and response controls.",
        "3  Clinical benefit",
        "?",
        "Tissue access, safety,",
        "persistence and outcomes",
        "need relevant evidence.",
        "A surrogate needs a supported link",
        "to relevant biological activity.",
        "No universal release cutoff."
      ],
      "bothThemesHaveIdenticalText": true
    },
    {
      "group": "comparability",
      "textLabels": [
        "What changed in the lot?",
        "Can earlier evidence bridge?",
        "Compare a change, not just a name",
        "Same starting material, if suitable",
        "Old",
        "process",
        "New",
        "process",
        "Compare affected attributes",
        "Identity + composition",
        "Activity + impurities + stability",
        "Methods and criteria must fit.",
        "Earlier evidence: bridge justified?",
        "Quality • safety • efficacy",
        "Or obtain more evidence.",
        "Similar alone ≠ clinically equivalent."
      ],
      "bothThemesHaveIdenticalText": true
    },
    {
      "group": "spps",
      "textLabels": [
        "Build while the chain stays",
        "attached to the resin",
        "1  Remove terminal protection",
        "Protected → open amino end",
        "2  Couple next protected unit",
        "New amino acid joins the chain",
        "3  Wash; tether stays attached",
        "Soluble leftovers leave",
        "Repeat 1–3 to extend the chain",
        "Then: cleave from resin",
        "Purify → identity / quality → release",
        "Schematic; no recipe or yield promise"
      ],
      "bothThemesHaveIdenticalText": true
    }
