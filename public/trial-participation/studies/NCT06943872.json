{"schemaVersion":1,"nct":"NCT06943872","source":"https://clinicaltrials.gov/study/NCT06943872","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT06943872","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:55:18.467Z","studySha256":"6a4fc5259a8bde0a5b2c0d3a7841538faa31474e431d31681a597d4ccaf43138","study":{"protocolSection":{"identificationModule":{"nctId":"NCT06943872","briefTitle":"A Study to Investigate Progression-Free Survival With Sonrotoclax Plus Obinutuzumab Or Sonrotoclax Plus Rituximab Compared With Venetoclax Plus Rituximab Treatment In Patients With Relapsed and/or Refractory Chronic Lymphocytic Leukemia/Small Lymphocytic Lymphoma (CELESTIAL-RRCLL)","officialTitle":"A Phase 3 Randomized, Open-Label, Multicenter Study of Sonrotoclax Plus Anti-CD20 Antibody Therapies Versus Venetoclax Plus Rituximab in Patients With Relapsed/Refractory Chronic Lymphocytic Leukemia/Small Lymphocytic Lymphoma"},"statusModule":{"statusVerifiedDate":"2026-03","overallStatus":"RECRUITING","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2025-06-11","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2029-09-30","type":"ESTIMATED"},"completionDateStruct":{"date":"2031-12","type":"ESTIMATED"},"studyFirstSubmitDate":"2025-04-17","studyFirstSubmitQcDate":"2025-04-17","studyFirstPostDateStruct":{"date":"2025-04-24","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-09-25","lastUpdatePostDateStruct":{"date":"2026-09-28","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"BeOne Medicines","class":"INDUSTRY"},"collaborators":[{"name":"German CLL Study Group","class":"OTHER"}]},"descriptionModule":{"briefSummary":"The goal of this study is to compare how well sonrotoclax plus obinutuzumab works versus venetoclax plus rituximab in treating adults with relapsed and/or refractory (R/R) chronic lymphocytic leukemia/small lymphocytic lymphoma (CLL/SLL). The study will also compare how well sonrotoclax plus rituximab works versus venetoclax plus rituxumab in treating adults with R/R CLL/SLL. The safety of these treatments will also be assessed.","detailedDescription":"Our company, previously known as BeiGene, is now officially BeOne Medicines. Because some of our older studies were sponsored under the name BeiGene, you may see both names used for this study on this website."},"conditionsModule":{"conditions":["Chronic Lymphocytic Leukemia","Small Lymphocytic Lymphoma"],"keywords":["B-cell lymphoma 2 inhibitor (BCL-2i)","CLL-RR1","German CLL Study Group"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":630,"type":"ESTIMATED"}},"armsInterventionsModule":{"armGroups":[{"label":"Arm A: Sonrotoclax plus Obinutuzumab","type":"EXPERIMENTAL","description":"Sonrotoclax and obinutuzumab will be administered in combination.","interventionNames":["Drug: Sonrotoclax","Drug: Obinutuzumab"]},{"label":"Arm B: Sonrotoclax plus Rituximab","type":"EXPERIMENTAL","description":"Sonrotoclax and rituximab will be administered in combination.","interventionNames":["Drug: Sonrotoclax","Drug: Rituximab"]},{"label":"Arm C: Sonrotoclax plus Obinutuzumab (MRD)","type":"EXPERIMENTAL","description":"Sonrotoclax and obinutuzumab will be administered in combination with treatment guided by evaluation of minimal residual disease (MRD).","interventionNames":["Drug: Sonrotoclax","Drug: Obinutuzumab"]},{"label":"Arm D: Venetoclax plus Rituximab","type":"ACTIVE_COMPARATOR","description":"Venetoclax and rituximab will be administered in combination.","interventionNames":["Drug: Rituximab","Drug: Venetoclax"]}],"interventions":[{"type":"DRUG","name":"Sonrotoclax","description":"Administered orally","armGroupLabels":["Arm A: Sonrotoclax plus Obinutuzumab","Arm B: Sonrotoclax plus Rituximab","Arm C: Sonrotoclax plus Obinutuzumab (MRD)"],"otherNames":["BGB-11417"]},{"type":"DRUG","name":"Obinutuzumab","description":"Administered intravenously","armGroupLabels":["Arm A: Sonrotoclax plus Obinutuzumab","Arm C: Sonrotoclax plus Obinutuzumab (MRD)"],"otherNames":["Gazyva"]},{"type":"DRUG","name":"Rituximab","description":"Administered intravenously","armGroupLabels":["Arm B: Sonrotoclax plus Rituximab","Arm D: Venetoclax plus Rituximab"],"otherNames":["Rituxan"]},{"type":"DRUG","name":"Venetoclax","description":"Administered Orally","armGroupLabels":["Arm D: Venetoclax plus Rituximab"],"otherNames":["Venclexta"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Progression-Free Survival (PFS) as assessed by Blinded Independent Review Committee (BIRC) for Arm A versus Arm D","description":"PFS is defined as the time from randomization to the date of progression or death, whichever occurs first.","timeFrame":"Up to approximately 51 months"}],"secondaryOutcomes":[{"measure":"Progression-Free Survival (PFS) as assessed by BIRC for Arm B versus Arm D","description":"PFS is defined as the time from randomization to the date of progression or death, whichever occurs first.","timeFrame":"Up to approximately 69 months"},{"measure":"Rate of uMRD4 for Arm A versus Arm D","description":"The rate of undetectable minimal residual disease (uMRD4) in peripheral blood based on next-generation sequencing (NGS)","timeFrame":"Up to approximately 12 months"},{"measure":"Complete Response Rate as assessed by BIRC for Arm A versus Arm D","description":"Complete Response Rate (CRR) is defined as the percentage of participants that achieve a best response of complete response (CR) or complete response with incomplete hematopoietic recovery (CRi)","timeFrame":"Up to approximately 25 months"},{"measure":"Overall Survival for Arm A versus Arm D","description":"Overall survival (OS) is defined as the time from the date of randomization to the date of death","timeFrame":"Up to approximately 84 months"},{"measure":"PFS per Investigator Assessment (INV) for Arm B versus Arm D","description":"PFS is defined as the time from randomization to the date of progression or death, whichever occurs first.","timeFrame":"Up to approximately 69 months"},{"measure":"CRR per BIRC and by INV for Arm B versus Arm D","description":"CRR is defined as the percentage of participants that achieve a best response of CR or CRi","timeFrame":"Up to approximately 25 months"},{"measure":"OS for Arm B versus Arm D","description":"OS is defined as the time from the date of randomization to the date of death","timeFrame":"Up to approximately 84 months"},{"measure":"Rate of uMRD4 for Arm B versus Arm D","description":"The rate of uMRD4 in peripheral blood based on NGS","timeFrame":"Up to approximately 25 months"},{"measure":"PFS per BIRC and by INV for Arm A versus Arm B","description":"PFS is defined as the time from randomization to the date of progression or death, whichever occurs first.","timeFrame":"Up to approximately 69 months"},{"measure":"CRR per BIRC and by INV for Arm A versus Arm B","description":"CRR is defined as the percentage of participants that achieve a best response of CR or CRi","timeFrame":"Up to approximately 25 months"},{"measure":"OS for Arm A versus Arm B","description":"OS is defined as the time from the date of randomization to the date of death","timeFrame":"Up to approximately 84 months"},{"measure":"Rate of uMRD4 for Arm A versus Arm B","description":"The rate of uMRD4 in peripheral blood based on NGS","timeFrame":"Up to approximately 25 months"},{"measure":"Rate of uMRD4 for Arm A versus Arm D","description":"The rate of uMRD4 in peripheral blood based on NGS","timeFrame":"Up to approximately 25 months"},{"measure":"CRR per INV for Arm A versus Arm D","description":"CRR is defined as the percentage of participants that achieve a best response of CR or CRi","timeFrame":"Up to approximately 25 months"},{"measure":"PFS per INV for Arm A versus Arm D","description":"PFS is defined as the time from randomization to the date of progression or death, whichever occurs first.","timeFrame":"Up to approximately 51 months"},{"measure":"PFS per INV for Arm C versus Arm D","description":"PFS is defined as the time from randomization to the date of progression or death, whichever occurs first.","timeFrame":"Up to approximately 69 months"},{"measure":"CRR per INV for Arm C versus Arm D","description":"CRR is defined as the percentage of participants that achieve a best response of CR or CRi","timeFrame":"Up to approximately 25 months"},{"measure":"OS for Arm C versus Arm D","description":"OS is defined as the time from the date of randomization to the date of death","timeFrame":"Up to approximately 84 months"},{"measure":"Rate of uMRD4 for Arm C versus Arm D","description":"The rate of uMRD4 in peripheral blood based on NGS","timeFrame":"Up to approximately 25 months"},{"measure":"Overall Response Rate (ORR) per BIRC and by INV","description":"ORR is defined as the percentage of participants that achieve a best response of partial response (PR) or better","timeFrame":"Up to approximately 25 months"},{"measure":"Duration of Response (DOR) per BIRC and by INV","description":"DOR is defined as the time from the date that response criteria were first met to the date of first documentation of disease progression or death, whichever occurs first","timeFrame":"Up to approximately 69 months"},{"measure":"Time to Response (TTR) per BIRC and by INV","description":"TTR is defined as the time from the date of randomization to the date response criteria were first met","timeFrame":"Up to approximately 25 months"},{"measure":"Time to Next Anti-CLL/SLL Treatment (TTNT)","description":"TTNT is defined as the time from the date of randomization to the date of next anti-CLL/SLL treatment","timeFrame":"Up to approximately 84 months"},{"measure":"Rate of uMRD4","description":"The rate of uMRD4 in peripheral blood based on NGS","timeFrame":"Up to approximately 25 months"},{"measure":"Change from Baseline in the European Organisation of Research and Treatment of Cancer-Quality of Life Questionnaire Core 30 (EORTC-QLQ-C30) Global Health Status/Quality of Life and Physical Functioning Scales","description":"The EORTC QLQ-30 contains 30 questions that incorporate 5 functional scales (physical functioning, role functioning, emotional functioning, cognitive functioning, and social functioning), 1 global health status scale, 3 symptom scales (fatigue, nausea and vomiting, and pain), and 6 single items (dyspnea, insomnia, appetite loss, constipation, diarrhea, and financial difficulties). The participant answers questions about their health during the past week. There are 28 questions answered on a 4-point scale where 1 =Not at all (best) to 4 =Very Much (worst) and 2 questions answered on a 7-point scale where 1 =Very poor (worst) to 7 =Excellent (best). Higher scores in global health status (GHS) and functional scales indicate better health-related quality of life (HRQoL).","timeFrame":"Baseline and up to approximately 69 months"},{"measure":"Change from Baseline in EORTC QLQ for Chronic Lymphocytic Leukemia (EORTC QLQ-CLL17) Symptom Burden and Fatigue Scales","description":"The EORTC QLQ-CLL17 is the CLL module of QLQ-C30 consisting of 17 items and comprising 3 scales: symptom burden due to disease and/or treatment (6 items), physical condition/fatigue (4 items), and worries/fears about health and functioning (7 items) Items are rated using a 4-point response scale (\"not at all,\" \"a little,\" \"quite a bit,\" and \"very much\") and the recall period for all items is the past 7 days. Lower scores indicate better HRQoL.","timeFrame":"Baseline and up to approximately 69 months"},{"measure":"Number of Participants with Treatment-Emergent Adverse Events (TEAEs)","description":"Number of participants with TEAEs, including laboratory values, vital signs, and physical examination findings, graded according to National Cancer Institute Common Terminology Criteria for Adverse Events (NCI-CTCAE) v5.0.","timeFrame":"From the first dose of study drug(s) to 30 days after the last dose of sonrotoclax or venetoclax, or 90 days after the last dose of obinutuzumab or rituximab; up to approximately 26 months"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Confirmed diagnosis of CLL/SLL that meets the International Workshop on Chronic Lymphocytic Leukemia (iwCLL) criteria\n* Received one or more prior therapies for CLL/SLL. For each line of therapy, participants must have received at least 2 cycles of the therapy\n* Participants with prior BCL2i exposure are eligible if remission duration was ≥3 years with ≥2 years from last BCL2i intake\n* Eastern Cooperative Oncology Group (ECOG) Performance Status score of 0, 1, or 2\n* Adequate organ function\n\nExclusion Criteria:\n\n* Known active prolymphocytic leukemia or currently suspected Richter's transformation\n* Prior autologous stem cell transplantation or chimeric antigen receptor T-cell therapy within 3 months before first dose of study drug\n* Prior allogeneic stem cell transplant with active graft-versus-host disease (GVHD), requiring immunosuppressive drugs for treatment of GVHD, or have taken calcineurin inhibitors within 4 weeks prior to consent\n* Known central nervous system involvement by CLL/SLL\n* Severe or debilitating pulmonary disease\n* Clinically significant cardiovascular disease\n\nNOTE: Other protocol defined Inclusion/Exclusion criteria may apply.","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"Uci Health Laguna Hills","status":"RECRUITING","city":"Laguna Hills","state":"California","zip":"92653","country":"United States","geoPoint":{"lat":33.61252,"lon":-117.71283}},{"facility":"Chao Family Comprehensive Cancer Center","status":"RECRUITING","city":"Orange","state":"California","zip":"92868-3201","country":"United States","geoPoint