{"schemaVersion":1,"nct":"NCT02574078","source":"https://clinicaltrials.gov/study/NCT02574078","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT02574078","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:52:48.013Z","studySha256":"fa3e2c9cb2f05519c5420b9f0a7e0a5cd8b2a701d9c48f8344dbe2b4eef54b79","study":{"protocolSection":{"identificationModule":{"nctId":"NCT02574078","briefTitle":"A Study of Nivolumab in Advanced Non-Small Cell Lung Cancer (NSCLC)","officialTitle":"A Master Protocol of Phase 1/2 Studies of Nivolumab in Advanced NSCLC Using Nivolumab as Maintenance After Induction Chemotherapy or as First-line Treatment Alone or in Combination With Standard of Care Therapies (CheckMate 370: CHECKpoint Pathway and nivoluMAb Clinical Trial Evaluation 370)","acronym":"CheckMate370"},"statusModule":{"statusVerifiedDate":"2021-04","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2015-11-23","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2020-04-15","type":"ACTUAL"},"completionDateStruct":{"date":"2020-04-15","type":"ACTUAL"},"studyFirstSubmitDate":"2015-10-09","studyFirstSubmitQcDate":"2015-10-09","studyFirstPostDateStruct":{"date":"2015-10-12","type":"ESTIMATED"},"resultsFirstSubmitDate":"2021-03-15","resultsFirstSubmitQcDate":"2021-04-12","resultsFirstPostDateStruct":{"date":"2021-05-06","type":"ACTUAL"},"lastUpdateSubmitDate":"2021-04-12","lastUpdatePostDateStruct":{"date":"2021-05-06","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Bristol-Myers Squibb","class":"INDUSTRY"}},"descriptionModule":{"briefSummary":"The purpose of this study is to determine whether nivolumab monotherapy or in combination with Standard of care (SOC) therapies will provide clinical benefit (i.e., PFS, OS, and DOR) without unacceptable toxicity in advanced Non-Small Cell Lung Cancer patients.","detailedDescription":"Epidermal Growth Factor Receptor (EGFR), Anap