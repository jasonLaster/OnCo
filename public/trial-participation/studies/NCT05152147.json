{"schemaVersion":1,"nct":"NCT05152147","source":"https://clinicaltrials.gov/study/NCT05152147","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT05152147","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:53:35.774Z","studySha256":"fe3a22137f42a7c26e748815ab3da8507cb55a190a4c0aaf9db6960095ddd640","study":{"protocolSection":{"identificationModule":{"nctId":"NCT05152147","briefTitle":"A Study of Zanidatamab in Combination With Chemotherapy Plus or Minus Tislelizumab in Patients With HER2-positive Advanced or Metastatic Gastric and Esophageal Cancers","officialTitle":"A Randomized, Multicenter, Phase 3 Study of Zanidatamab in Combination With Chemotherapy With or Without Tislelizumab in Subjects With HER2-positive Unresectable Locally Advanced or Metastatic Gastroesophageal Adenocarcinoma (GEA)","acronym":"HERIZON-GEA-01"},"statusModule":{"statusVerifiedDate":"2026-09","overallStatus":"ACTIVE_NOT_RECRUITING","expandedAccessInfo":{"hasExpandedAccess":true,"nctId":"NCT04578444","statusForNctId":"NO_LONGER_AVAILABLE"},"startDateStruct":{"date":"2021-12-02","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2026-07-15","type":"ACTUAL"},"completionDateStruct":{"date":"2027-09-30","type":"ESTIMATED"},"studyFirstSubmitDate":"2021-11-05","studyFirstSubmitQcDate":"2021-12-03","studyFirstPostDateStruct":{"date":"2021-12-09","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-09-22","lastUpdatePostDateStruct":{"date":"2026-09-24","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Jazz Pharmaceuticals","class":"INDUSTRY"},"collaborators":[{"name":"BeOne Medicines LTD","class":"UNKNOWN"},{"name":"BeOne Pharmaceutical Co., Ltd.","class":"UNKNOWN"}]},"descriptionModule":{"briefSummary":"This study is being done to find out if zanidatamab, when given with chemotherapy plus or minus tislelizumab, is safe and works better than trastuzumab given with chemotherapy.\n\nThe patients in this study will have advanced human epidermal growth factor 2 (HER2)-positive stomach and esophageal cancers that are no longer treatable with surgery (unresectable) or chemoradiation, and/or have grown or spread to other parts of the body (metastatic)."},"conditionsModule":{"conditions":["Gastric Neoplasms","Gastroesophageal Adenocarcinoma","Esophageal Adenocarcinoma"],"keywords":["HER2","Bispecific antibody","Biparatopic antibody","Immunotherapy","Gastric cancers","Esophageal cancers","Chemotherapy","FP","Capecitabine","Cisplatin","5-FU","Oxaliplatin","Gastroesophageal adenocarcinoma","CAPOX","Programmed cell death receptor 1 (PD-1)","Anti-PD-1","Anti PD-1","JZP598"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","interventionModelDescription":"multi-cohort, open-label, multicenter study","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":920,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Arm A","type":"ACTIVE_COMPARATOR","description":"Trastuzumab (Herceptin®) plus physician's choice of capecitabine plus oxaliplatin (CAPOX) or 5-fluorouracil (5-FU) plus cisplatin (FP)","interventionNames":["Drug: Trastuzumab","Drug: Capecitabine","Drug: Oxaliplatin","Drug: Cisplatin","Drug: 5-Fluorouracil"]},{"label":"Arm B","type":"EXPERIMENTAL","description":"Zanidatamab plus physician's choice of CAPOX or FP","interventionNames":["Drug: Zanidatamab","Drug: Capecitabine","Drug: Oxaliplatin","Drug: Cisplatin","Drug: 5-Fluorouracil"]},{"label":"Arm C","type":"EXPERIMENTAL","description":"Zanidatamab and tislelizumab plus physician's choice of CAPOX or FP","interventionNames":["Drug: Zanidatamab","Drug: Tislelizumab","Drug: Capecitabine","Drug: Oxaliplatin","Drug: Cisplatin","Drug: 5-Fluorouracil"]}],"interventions":[{"type":"DRUG","name":"Zanidatamab","description":"Administered IV","armGroupLabels":["Arm B","Arm C"],"otherNames":["ZW25","JZP598","ZIIHERA®"]},{"type":"DRUG","name":"Tislelizumab","description":"Administered IV","armGroupLabels":["Arm C"]},{"type":"DRUG","name":"Trastuzumab","description":"Administered intravenously (IV)","armGroupLabels":["Arm A"],"otherNames":["Herceptin®"]},{"type":"DRUG","name":"Capecitabine","description":"Administered orally (PO bid)","armGroupLabels":["Arm A","Arm B","Arm C"]},{"type":"DRUG","name":"Oxaliplatin","description":"Administered IV","armGroupLabels":["Arm A","Arm B","Arm C"]},{"type":"DRUG","name":"Cisplatin","description":"Administered IV","armGroupLabels":["Arm A","Arm B","Arm C"]},{"type":"DRUG","name":"5-Fluorouracil","description":"Administered IV","armGroupLabels":["Arm A","Arm B","Arm C"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Progression-free survival (PFS) by BICR","description":"The time from randomization to the date of documented disease progression (per Response Evaluation Criteria in Solid Tumors \\[RECIST\\] version 1.1) as assessed by blinded independent central review (BICR) or death from any cause","timeFrame":"Up to 2.5 years"},{"measure":"Overall survival","description":"The time from randomization to death due to any cause","timeFrame":"Up to 3.5 years"}],"secondaryOutcomes":[{"measure":"Confirmed objective response rate (ORR) by BICR","description":"Number of patients who achieved a best overall response of complete response (CR) or (PR) as determined per RECIST 1.1 as assessed by BICR","timeFrame":"Up to 2.5 years"},{"measure":"Duration of response (DOR) by BICR","description":"The time from the first objective response (CR or PR) per BICR to documented progressive disease per RECIST 1.1 as assessed by BICR or death from any cause","timeFrame":"Up to 2.5 years"},{"measure":"PFS per Investigator assessment","description":"The time from randomization to the date of documented disease progression (per RECIST 1.1) as assessed by Investigator or death from any cause","timeFrame":"Up to 2.5 years"},{"measure":"Confirmed ORR per Investigator assessment","description":"Number of patients who achieved a best overall response of CR or PR as determined per RECIST 1.1 as assessed by Investigator","timeFrame":"Up to 2.5 years"},{"measure":"DOR per Investigator assessment","description":"The time from the first objective response (CR or PR) per Investigator to documented progressive disease per RECIST 1.1 as assessed by Investigator or death from any cause","timeFrame":"Up to 2.5 years"},{"measure":"Assessment of Contribution of Components based on Progression-free Survival (PFS) by BICR","description":"The time from randomization to the date of documented disease progression (per Response Evaluation Criteria in Solid Tumors \\[RECIST\\] version 1.1) as assessed by blinded independent central review (BICR) or death from any cause","timeFrame":"Up to 2.5 years"},{"measure":"Assessment of Contribution of Components based on Overall Survival","description":"The time from randomization to death due to any cause","timeFrame":"Up to 3.5 years"},{"measure":"Incidence of adverse events","description":"Number of subjects who experienced adverse events or serious adverse events","timeFrame":"Up to 2 years"},{"measure":"Incidence of clinical laboratory abnormalities","description":"Number of patients who experienced a maximum severity of Grade 3 or higher post-baseline laboratory abnormality, including either hematology or chemistry. Grades are defined using National Cancer Institute's Common Terminology Criteria for Adverse Events (CTCAE), version 5.0","timeFrame":"Up to 2 years"},{"measure":"Health-related quality of life (HRQoL) as assessed by the European Organisation for Research and Treatment of Cancer (EORTC) Quality of Life Questionnaire (core cancer questionnaire) C30 (QLQ-C30)","description":"Changes from baseline in the EORTC QLQ-C30 scores","timeFrame":"Up to 2.5 years"},{"measure":"HRQoL as assessed by the EORTC Quality of Life Questionnaire (oesophago-gastric module) OG25 (QLQ-OG25)","description":"Changes from baseline in the EORTC QLQ-OG25 scores","timeFrame":"Up to 2.5 years"},{"measure":"HRQoL as assessed by the EuroQol 5-dimensions 5-levels (EQ-5D-5L) questionnaire","description":"Changes from baseline in the EORTC EQ-5D-5L questionnaire scores","timeFrame":"Up to 2.5 years"},{"measure":"Serum concentration of zanidatamab and tislelizumab","timeFrame":"Up to 2 years"},{"measure":"Incidence of anti-drug antibodies (ADAs)","description":"Number of patients who develop ADAs","timeFrame":"Up to 2 years"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Histologically confirmed unresectable locally advanced, recurrent or metastatic HER2-positive gastroesophageal adenocarcinoma (adenocarcinomas of the stomach or esophagus, including the gastroesophageal junction), defined as 3+ HER2 expression by IHC or 2+ HER2 expression by IHC with ISH positivity per central assessment. Subjects with esophageal adenocarcinoma must not be eligible for combined chemoradiotherapy at the time of enrollment\n* Assessable (measurable or non-measurable) disease as defined by RECIST 1.1\n* Eastern Cooperative Oncology Group (ECOG) performance status score of 0 or 1, assessed within 3 days prior to randomization\n* Adequate organ function\n* Left ventricular ejection fraction (LVEF) ≥ 50% as determined by either echocardiogram or multiple gated acquisition scan (MUGA)\n\nExclusion Criteria:\n\n* Prior treatment with a HER2-targeted agent, with the exception of subjects who received HER2-targeted treatment for breast cancer \\> 5 years prior to initial diagnosis of GEA\n* Prior treatment with an anti-PD-1, anti-PD-L1, anti-PD-L2 or any other antibody or drug specifically targeting T-cell co-stimulation or checkpoint pathways\n* Prior treatment with systemic antineoplastic therapy or intraperitoneal chemotherapy for unresectable locally advanced, recurrent or metastatic GEA\n* Untreated central nervous system (CNS) metastases, symptomatic CNS metastases, or radiation treatment for CNS metastases within 4 weeks prior to randomization. Stable, treated brain metastases are allowed (defined as subjects who are completely off steroids and anticonvulsants and are neurologically stable with no evidence of radiographic progression for at least 4 weeks prior to randomization)\n* Known history of or ongoing leptomeningeal disease (LMD)\n* Known additional malignancy that is not considered cured or that has required treatment within the past 3 years\n* Known active hepatitis\n* Any history of human immunodeficiency virus (HIV) infection\n* Known SARS-CoV-2 infection; subjects with prior infection that has resolved per local institutions' requirements and screening guidance are eligible\n* QTc Fridericia (QTcF) \\> 470 ms\n* Clinically significant cardiac disease, such as ventricular arrhythmia requiring therapy, uncontrolled hypertension or any history of symptomatic congestive heart failure (CHF)","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"Hospital de Gastroenterología Dr Bonorino Udaondo","city":"Buenos Aires","zip":"1264","country":"Argentina","geoPoint":{"lat":-34.61315,"lon":-58.37723}},{"facility":"Instituto de Investigaciones Metabólicas - IDIM","city":"Buenos Aires","zip":"C1012","country":"Argentina","geoPoint":{"lat":-34.61315,"lon":-58.37723}},{"facility":"Hospital Italiano de Buenos Aires","city":"Buenos Aires","zip":"C1181ACH","country":"Argentina","geoPoint":{"lat":-34.61315,"lon":-58.37723}},{"facility":"Fundación Centro de Medicina Nuclear y Molecular ER","city":"Córdoba","zip":"X5000HXL","country":"Argentina","geoPoint":{"lat":-31.40648,"lon":-64.18853}},{"facility":"Centro Médico Privado CEMAIC","city":"Córdoba","zip":"X5008HHW","country":"Argentina","geoPoint":{"lat":-31.40648,"lon":-64.18853}},{"facility":"Centro de Investigación Pergamino S.A.","city":"Pergamino","zip":"2700","country":"Argentina","geoPoint":{"lat":-33.89101,"lon":-6