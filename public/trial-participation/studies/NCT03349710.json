{"schemaVersion":1,"nct":"NCT03349710","source":"https://clinicaltrials.gov/study/NCT03349710","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT03349710","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:53:00.908Z","studySha256":"6cf44e59224dc543f982aee9033a86b4933720d4cfe8938bf1547fa4550bddf4","study":{"protocolSection":{"identificationModule":{"nctId":"NCT03349710","briefTitle":"Nivolumab or Nivolumab Plus Cisplatin, in Combination With Radiotherapy in Patients With Cisplatin-ineligible or Eligible Locally Advanced Squamous Cell Head and Neck Cancer","officialTitle":"A Randomized, Double-blind, Placebo-controlled, Phase 3 Study of Nivolumab or Nivolumab Plus Cisplatin, in Combination With Radiotherapy in Participants With Cisplatin Ineligible and Cisplatin Eligible Locally Advanced Squamous Cell Carcinoma of the Head and Neck (SCCHN)"},"statusModule":{"statusVerifiedDate":"2021-08","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2017-12-15","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2019-10-14","type":"ACTUAL"},"completionDateStruct":{"date":"2019-10-14","type":"ACTUAL"},"studyFirstSubmitDate":"2017-11-17","studyFirstSubmitQcDate":"2017-11-17","studyFirstPostDateStruct":{"date":"2017-11-21","type":"ACTUAL"},"resultsFirstSubmitDate":"2020-10-13","resultsFirstSubmitQcDate":"2021-08-05","resultsFirstPostDateStruct":{"date":"2021-08-09","type":"ACTUAL"},"lastUpdateSubmitDate":"2021-08-05","lastUpdatePostDateStruct":{"date":"2021-08-09","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Bristol-Myers Squibb","class":"INDUSTRY"},"collaborators":[{"name":"Ono Pharmaceutical Co., Ltd.","class":"INDUSTRY"}]},"descriptionModule":{"briefSummary":"This study has two, independent, cohorts, both in locally advanced squamous cell head and neck cancer. The purpose of the first cohort is to determine whether nivolumab in combination with radiotherapy is more effective than cetuximab in combination with radiotherapy, in subjects who are ineligible for cisplatin. The purpose of the second cohort is to determine whether nivolumab, cisplatin, and radiotherapy is more effective than cisplatin and radiotherapy in subjects who are eligible to receive cisplatin"},"conditionsModule":{"conditions":["Squamous Cell Carcinoma of the Head and Neck"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":74,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Arm A","type":"EXPERIMENTAL","description":"Cohort 1","interventionNames":["Biological: Nivolumab","Radiation: Radiotherapy"]},{"label":"Arm B","type":"EXPERIMENTAL","description":"Cohort 1","interventionNames":["Drug: Cetuximab","Radiation: Radiotherapy"]},{"label":"Arm C","type":"EXPERIMENTAL","description":"Cohort 2","interventionNames":["Biological: Nivolumab","Drug: Cisplatin","Radiation: Radiotherapy"]},{"label":"Arm D","type":"EXPERIMENTAL","description":"Cohort 2","interventionNames":["Drug: Cisplatin","Radiation: Radiotherapy"]}],"interventions":[{"type":"BIOLOGICAL","name":"Nivolumab","description":"Specified dose on specified day","armGroupLabels":["Arm A","Arm C"],"otherNames":["BMS-936558","Opdivo"]},{"type":"DRUG","name":"Cetuximab","description":"Specified dose on specified day","armGroupLabels":["Arm B"],"otherNames":["Erbitux"]},{"type":"DRUG","name":"Cisplatin","description":"Specified dose on specified day","armGroupLabels":["Arm C","Arm D"]},{"type":"RADIATION","name":"Radiotherapy","description":"Specified dose on specified day","armGroupLabels":["Arm A","Arm B","Arm C","Arm D"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Number of Participants With an Adverse Event (AE)","description":"Number of Participants with an Adverse Event","timeFrame":"30 Days"},{