{"schemaVersion":1,"nct":"NCT00128479","source":"https://clinicaltrials.gov/study/NCT00128479","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT00128479","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:51:56.584Z","studySha256":"9d6ec1f5ae90a8753ca113857e2c92eb802ee825744388b8dde0ca1883d14688","study":{"protocolSection":{"identificationModule":{"nctId":"NCT00128479","briefTitle":"A United States Study of the Safety and Tolerability of Corlux for Psychotic Symptoms in Psychotic Major Depression","officialTitle":"A Randomized, Double-Blind, Placebo-Controlled, Parallel Group Study of the Safety and Efficacy of Three Dose Levels of CORLUX™ (Mifepristone) Plus an Antidepressant vs. Placebo Plus an Antidepressant in the Treatment of Psychotic Symptoms in Patients With Major Depressive Disorder With Psychotic Features (PMD)"},"statusModule":{"statusVerifiedDate":"2012-02","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2004-09"},"primaryCompletionDateStruct":{"date":"2007-01","type":"ACTUAL"},"completionDateStruct":{"date":"2007-01","type":"ACTUAL"},"studyFirstSubmitDate":"2005-08-08","studyFirstSubmitQcDate":"2005-08-08","studyFirstPostDateStruct":{"date":"2005-08-10","type":"ESTIMATED"},"lastUpdateSubmitDate":"2012-02-14","lastUpdatePostDateStruct":{"date":"2012-02-15","type":"ESTIMATED"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Corcept Therapeutics","class":"INDUSTRY"}},"descriptionModule":{"briefSummary":"Corlux (mifepristone) is a new medication that modulates the body's use of a hormone called cortisol. Under normal conditions, cortisol and other hormones are created by the body in response to physical and emotional stress, triggering a healthy stress response. People who suffer from psychotic major depression may have unusually high levels of cortisol circulating within them or abnormal patterns of cortisol levels, overloading the stress response mechanism and causing symptoms of psychosis such as delusional thoughts or hallucinations. If Corlux can keep the body's cortisol receptors from being overloaded, the stress response system may return to normal function, which may result in improvement of symptoms. The purpose of this 56 day study is to learn the safety and effectiveness of Corlux in patients who have been diagnosed with psychotic major depression (PMD)."},"conditionsModule":{"conditions":["Major Depressive Disorder","Psychotic Disorders"],"keywords":["PMD","Psychotic Depression","Psychosis","Major Depression","Depression","Psychotic Major Depression"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"DOUBLE","whoMasked":["PARTICIPANT","INVESTIGATOR"]}},"enrollmentInfo":{"count":443,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"mifepristone 300 mg","type":"EXPERIMENTAL","interventionNames":["Drug: mifepristone"]},{"label":"placebo","type":"PLACEBO_COMPARATOR","interventionNames":["Drug: mifepristone matched placebo"]},{"label":"mifepristone 600 mg","type":"EXPERIMENTAL","interventionNames":["Drug: mifepristone 600 mg"]},{"label":"mifepristone 1200 mg","type":"EXPERIMENTAL","interventionNames":["Drug: mifepristone 1200 mg"]}],"interventions":[{"type":"DRUG","name":"mifepristone","description":"mifepristone 300 mg daily for 7 dats","armGroupLabels":["mifepristone 300 mg"]},{"type":"DRUG","name":"mifepristone matched placebo","description":"daily for 7 days","armGroupLabels":["placebo"]},{"type":"DRUG","name":"mifepristone 600 mg","description":"mifepristone 600 mg daily for 7 days","armGroupLabels":["mifepristone 600 mg"]},{"type":"DRUG","name":"mifepristone 1200 mg","description":"mifepristone 1200 mg daily for 7 days","armGroupLabels":["mifepristone 1200 mg"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"The change in a measure of psychosis","timeFrame":"screen, Days 0, 7, 14, 28, 42, 56"}],"secondaryOutcomes":[{"measure":"The change in a measure of depression","timeFrame":"screen, Days 0,7, 14, 28, 42, 56"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\nIndividuals eligible for enrollment into this study are male and female adult patients who:\n\n* Are 18 to 75 years of age\n* Have a diagnosis of major depressive disorder with psychotic features (DSM-IV 296.24 or 296.34)\n* Are able to provide written informed consent.\n\nExclusion Criteria:\n\nIndividuals not eligible to be enrolled into the study are those who:\n\n* Have a major medical problem\n* Have previously participated in a CORLUX (C-1073, mifepristone) clinical trial\n* Have a history of an allergic reaction to CORLUX (C-1073, mifepristone).","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","maximumAge":"75 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"K&S Research Services","city":"Little Rock","state":"Arkansas","zip":"72201","country":"United States","geoPoint":{"lat":34.74648,"lon":-92.28959}},{"facility":"Center for Emotional Fitness","city":"Cerritos","state":"California","zip":"90703","country":"United States","geoPoint":{"lat":33.85835,"lon":-118.06479}},{"facility":"Harbor Medical Associates, Inc.","city":"Fountain Valley","state":"California","zip":"92708","country":"United States","geoPoint":{"lat":33.70918,"lon":-117.95367}},{"facility":"Synergy Clinical Research Center","city":"National City","state":"California","zip":"91950","country":"United States","geoPoint":{"lat":32.67811,"lon":-117.0992}},{"facility":"Excell Research","city":"Oceanside","state":"California","zip":"92056","country":"United States","geoPoint":{"lat":33.19587,"lon":-117.37948}},{"facility":"Pacific Clinical Research Medical Group","city":"Riverside","state":"California","zip":"92506","country":"United States","geoPoint":{"lat":33.95335,"lon":-117.39616}},{"facility":"