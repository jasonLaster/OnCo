    {
      "id": "tcr-t-simple",
      "kind": "reader-summary-entry",
      "name": "TCR-T cell therapy (simple)",
      "canonicalRecordId": "tcr-t",
      "language": "simple",
      "available": true,
      "text": "TCR-T uses living T cells with a chosen receptor. It recognises a protein piece held by a matching HLA molecule on a cell; the source protein’s name alone does not show that target."
    },
    {
      "id": "neoantigen-simple",
      "kind": "reader-summary-entry",
      "name": "Neoantigen (simple)",
      "canonicalRecordId": "neoantigen",
      "language": "simple",
      "available": true,
      "text": "A changed tumour sequence can make a new protein piece. Immune cells may recognise it, but tests still need to check display, recognition and harm to healthy cells."
    },
    {
      "id": "neoantigen-candidate-selection-simple",
      "kind": "reader-summary-entry",
      "name": "Neoantigen candidate selection (simple)",
      "canonicalRecordId": "neoantigen-candidate-selection",
      "language": "simple",
      "available": true,
      "text": "A target list should show what is known, what remains untested and which failures the candidates share. A long list or a good computer score does not prove safe tumour recognition."
    },
