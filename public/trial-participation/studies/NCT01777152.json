{"schemaVersion":1,"nct":"NCT01777152","source":"https://clinicaltrials.gov/study/NCT01777152","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT01777152","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:52:33.749Z","studySha256":"23094e33ccd7bd21995dd5067b5cf7b45a8416edcdd836f8a4215d91be0af7d0","study":{"protocolSection":{"identificationModule":{"nctId":"NCT01777152","briefTitle":"ECHELON-2: A Comparison of Brentuximab Vedotin and CHP With Standard-of-care CHOP in the Treatment of Patients With CD30-positive Mature T-cell Lymphomas","officialTitle":"A Randomized, Double-blind, Placebo-controlled, Phase 3 Study of Brentuximab Vedotin and CHP (A+CHP) Versus CHOP in the Frontline Treatment of Patients With CD30-positive Mature T-cell Lymphomas","acronym":"ECHELON-2"},"statusModule":{"statusVerifiedDate":"2021-11","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2013-01-31","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2018-08-15","type":"ACTUAL"},"completionDateStruct":{"date":"2020-10-02","type":"ACTUAL"},"studyFirstSubmitDate":"2013-01-23","studyFirstSubmitQcDate":"2013-01-25","studyFirstPostDateStruct":{"date":"2013-01-28","type":"ESTIMATED"},"resultsFirstSubmitDate":"2019-07-10","resultsFirstSubmitQcDate":"2019-07-10","resultsFirstPostDateStruct":{"date":"2019-07-30","type":"ACTUAL"},"lastUpdateSubmitDate":"2021-11-01","lastUpdatePostDateStruct":{"date":"2021-11-30","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Seagen Inc.","class":"INDUSTRY"},"collaborators":[{"name":"Millennium Pharmaceuticals, Inc.","class":"INDUSTRY"}]},"descriptionModule":{"briefSummary":"This is a double-blind, randomized, multicenter, phase 3 clinical trial to compare the efficacy and safety of brentuximab vedotin in combination with CHP with the standard-of-care CHOP in patients with CD30-positive mature T-cell lymphomas."},"conditionsModule":{"conditions":["Anaplastic Large-Cell Lymphoma","Non-Hodgkin Lymphoma","T-Cell Lymphoma"],"keywords":["Antibodies, Monoclonal","Antibody-Drug Conjugate","Antigens, CD30","Drug Therapy","Hematologic Diseases","Lymphoma","Monomethyl auristatin E","Lymphoma, T-Cell","Lymphoma, Non-Hodgkin","Lymphoma, Large-Cell, Anaplastic"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"DOUBLE","whoMasked":["PARTICIPANT","INVESTIGATOR"]}},"enrollmentInfo":{"count":452,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"CHOP","type":"ACTIVE_COMPARATOR","description":"cyclophosphamide, doxorubicin, vincristine, and prednisone","interventionNames":["Drug: doxorubicin","Drug: prednisone","Drug: vincristine","Drug: cyclophosphamide"]},{"label":"A+CHP","type":"EXPERIMENTAL","description":"brentuximab vedotin, cyclophosphamide, doxorubicin, and prednisone","interventionNames":["Drug: brentuximab vedotin","Drug: doxorubicin","Drug: prednisone","Drug: cyclophosphamide"]}],"interventions":[{"type":"DRUG","name":"brentuximab vedotin","description":"1.8 mg/kg every 3 weeks by IV infusion for 6-8 cycles","armGroupLabels":["A+CHP"],"otherNames":["Adcetris; SGN-35"]},{"type":"DRUG","name":"doxorubicin","description":"50 mg/m2 every 3 weeks by IV infusion for 6-8 cycles","armGroupLabels":["A+CHP","CHOP"]},{"type":"DRUG","name":"prednisone","description":"100 mg on Days 1 to 5 of each 3-week cycle, orally for 6-8 cycles","armGroupLabels":["A+CHP","CHOP"]},{"type":"DRUG","name":"vincristine","description":"1.4 mg/m2 (maximum 2 mg) every 3 weeks by IV infusion for 6-8 cycles","armGroupLabels":["CHOP"]},{"type":"DRUG","name":"cyclophosphamide","description":"750 mg/m2 every 3 weeks by IV infusion for 6-8 cycles","armGroupLabels":["A+CHP","CHOP"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Progression-free Survival Per Independent Review Facility (IRF)","description":"The time from the date of randomization to the date of first documentation of progressive disease (PD), death due to any cause, or receipt of subsequent anticancer chemotherapy to treat residual or progressive disease whichever occurred first.","timeFrame":"Up to 60 months"}],"secondaryOutcomes":[{"measure":"Progression-free Survival Per IRF in Patients With Systemic Anaplastic Large Cell Lymphoma (sALCL)","description":"The time from the date of randomization to the date of first documentation of progressive disease (PD), death due to any cause, or receipt of subsequent anticancer chemotherapy to treat residual or progressive disease whichever occurred first.","timeFrame":"Up to 60 months"},{"measure":"Complete Remission (CR) Rate Per IRF at End of Treatment (EOT)","description":"The count of participants with CR per IRF following the completion of study treatment (at end of treatment or at the first assessment after the last dose of study treatment and prior to long-term follow-up) according to the Revised Response Criteria for Malignant Lymphoma.","timeFrame":"Up to 8.34 months"},{"measure":"Overall Survival (OS)","description":"The time from randomization to death due to any cause.","timeFrame":"Up to 90 months"},{"measure":"Objective Response Rate (ORR) Per IRF at End of Treatment","description":"The count of participants with CR or partial response (PR) per IRF following the completion of study treatment (at end of treatment or the first assessment after the last dose of study treatment and prior to long-term follow-up) according to the Revised Response Criteria for Malignant Lymphoma.","timeFrame":"Up to 8.34 months"},{"measure":"Incidence of Adverse Events (AEs)","description":"Any untoward medical occurrence in a clinical investigational participant administered a medicinal product which does not necessarily have a causal relationship with this treatment.","timeFrame":"Up to 8.28 months"},{"measure":"Incidence of Laboratory Abnormalities",