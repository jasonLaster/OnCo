  "units": [
    {
      "sourceId": "P68-MR-01",
      "claimClass": "premise",
      "requirement": "A mixture of RNA products,a joint formulation,per-particle loading,same-cell delivery and relative protein expression are separate observations.",
      "freshCanonicalDisposition": "Not compared at seal",
      "mainCredit": 0,
      "liveCredit": 0
    },
    {
      "sourceId": "P68-MR-02",
      "claimClass": "empirical",
      "requirement": "Zhang used defined mCherry/eGFP reporter ratios with Lipofectamine2000 in HeLa cells,mouse embryonic-stem-cell-derived retinal organoids and zebrafish embryos;the result is not universal to all carriers or clinical treatments.",
      "freshCanonicalDisposition": "Not compared at seal",
      "mainCredit": 0,
      "liveCredit": 0
    },
    {
      "sourceId": "P68-MR-03",
      "claimClass": "empirical",
      "requirement": "Mixtures of separately formulated single-RNA lipoplexes could give the intended population-average ratio while individual cells had variable uptake and expression;coformulated lipoplexes improved the single-cell correspondence in those models.",
      "freshCanonicalDisposition": "Not compared at seal",
      "mainCredit": 0,
      "liveCredit": 0
    },
    {
      "sourceId": "P68-MR-04",
      "claimClass": "premise",
      "requirement": "Formulation by premixing and an average loading estimate do not directly establish the cargo of every particle;the reported evenly distributed per-particle composition is an assumption.",
      "freshCanonicalDisposition": "Not compared at seal",
      "mainCredit": 0,
      "liveCredit": 0
    },
    {
      "sourceId": "P68-MR-05",
      "claimClass": "premise",
      "requirement": "Input RNA mass ratio and reporter fluorescence ratios do not automatically equal absolute molar protein stoichiometry,functional assembly or treatment benefit;the study explicitly found different detection and/or expression of the two reporters.",
      "freshCanonicalDisposition": "Not compared at seal",
      "mainCredit": 0,
      "liveCredit": 0
    },
    {
      "sourceId": "P68-MR-06",
      "claimClass": "empirical",
      "requirement": "FCS characterizes labeled cargo association/loading,whereas cellular fluorescence uptake and later unlabeled-RNA protein expression answer different questions at stated times.",
      "freshCanonicalDisposition": "Not compared at seal",
      "mainCredit": 0,
      "liveCredit": 0
    },
    {
      "sourceId": "P68-MR-07",
      "claimClass": "empirical",
      "requirement": "Chen compares mCherry lipoplexes attached to polymer microbubbles against lipoplexes administered beside them,not co-encapsulation of two different RNAs.",
      "freshCanonicalDisposition": "Not compared at seal",
      "mainCredit": 0,
      "liveCredit": 0
    },
    {
      "sourceId": "P68-MR-08",
      "claimClass": "empirical",
      "requirement": "Chen used DOTAP/DOPE lipoplexes and PBCA microbubbles in4T1 culture and subcutaneous4T1 tumors in female BALB/c mice,six per intervention group,with intravenous delivery and ultrasound;these are reporter-transfection outcomes rather than cancer-control or clinical-safety outcomes.",
      "freshCanonicalDisposition": "Not compared at seal",
      "mainCredit": 0,
      "liveCredit": 0
    },
    {
      "sourceId": "P68-MR-09",
      "claimClass": "empirical",
      "requirement": "Co-administration produced greater reporter-transfected area and signal farther from vessels,whereas co-formulation favored vascular/perivascular signal;histological percentages were image areas,not direct tumor-cell percentages,and distances above50micrometers were excluded.",
      "freshCanonicalDisposition": "Not compared at seal",
      "mainCredit": 0,
      "liveCredit": 0
    },
    {
      "sourceId": "P68-MR-10",
      "claimClass": "empirical",
      "requirement": "The in-vitro comparison tested with and without ultrasound;co-formulated lipoplex-microbubble transfection was more trigger-dependent. This does not supply a universal advantage of attaching all carriers to bubbles.",
      "freshCanonicalDisposition": "Not compared at seal",
      "mainCredit": 0,
      "liveCredit": 0
    },
    {
      "sourceId": "P68-MR-11",
      "claimClass": "empirical",
      "requirement": "The lower off-site signal in the co-formulated mouse comparison was in spleen;the liver differences were not statistically significant,and neither endpoint demonstrates safety in every tissue.",
      "freshCanonicalDisposition": "Not compared at seal",
      "mainCredit": 0,
      "liveCredit": 0
    },
    {
      "sourceId": "P68-MR-12",
      "claimClass": "premise",
      "requirement": "The two papers test different cargo and carrier comparisons;their results cannot be merged into a universal rule that co-formulation improves delivery or efficacy.",
      "freshCanonicalDisposition": "Not compared at seal",
      "mainCredit": 0,
      "liveCredit": 0
    }
