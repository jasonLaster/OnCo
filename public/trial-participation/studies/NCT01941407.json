{"schemaVersion":1,"nct":"NCT01941407","source":"https://clinicaltrials.gov/study/NCT01941407","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT01941407","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:52:36.298Z","studySha256":"37ebd762a7e321d108c4c8b0ce1c5f6d0dd461ca167f1564f5c3822081315c3b","study":{"protocolSection":{"identificationModule":{"nctId":"NCT01941407","briefTitle":"First Line Metastatic Breast Cancer Treatment (ESMERALDA)","officialTitle":"A PHASE II TRIAL EVALUATING THE COMBINATION OF ERIBULIN (HALAVEN®) + BEVACIZUMAB (AVASTIN®) AS A FIRST LINE TREATMENT IN PATIENTS WITH METASTATIC HER2- BREAST CANCER","acronym":"ESMERALDA"},"statusModule":{"statusVerifiedDate":"2016-03","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2013-11"},"primaryCompletionDateStruct":{"date":"2014-08","type":"ACTUAL"},"completionDateStruct":{"date":"2016-03","type":"ACTUAL"},"studyFirstSubmitDate":"2013-09-10","studyFirstSubmitQcDate":"2013-09-10","studyFirstPostDateStruct":{"date":"2013-09-13","type":"ESTIMATED"},"lastUpdateSubmitDate":"2016-03-15","lastUpdatePostDateStruct":{"date":"2016-03-17","type":"ESTIMATED"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"ARCAGY/ GINECO GROUP","class":"OTHER"}},"descriptionModule":{"briefSummary":"The efficacy of eribulin is now well known in metastatic breast cancer. Furthermore, a phase III combine study ( chemo + bev)in metastatic first line shown a gain in PFS with no extra toxicities.\n\nIt could be interesting to explore the combination of bev + eribulin in first line metastatic breast cancer."},"conditionsModule":{"conditions":["Metastatic Breast Cancer"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE2"],"designInfo":{"allocation":"NA","interventionModel":"SINGLE_GROUP","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":61,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Association eribulin and bevacizumab","type":"EXPERIMENTAL","description":"Drug: eribulin 1,23mg/m²; d1 and d8 in IV, all 3 weeks until 6 cycles or progression Drug: bevacizumab 15m/kg ; d1 in IV, all 3 weeks until 6 cycles or progression or toxicity","interventionNames":["Drug: Eribulin"]}],"interventions":[{"type":"DRUG","name":"Eribulin","description":"Eribulin: 1,23mg/m² d1, d8, IV Bevacizumab: 15mg/kg d1, IV","armGroupLabels":["Association eribulin and bevacizumab"],"otherNames":["Drug: Bevacizumab"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Number of patient with non progressive disease","description":"The principal endpoint is to determine the disease control rate (or rate of non-progression) at one year in patients with metastatic breast cancer treated in the first line setting by a combination of eribulin/bevacizumab.\n\nIn this open-label trial, the sample size is calculated based on Simon's two-stage design, used to test whether the disease control rate at one year will be at least 50%, a clinically promising rate, versus a rate of 33%, a rate that is not clinically promising.\n\nConsidering a type I risk (alpha) error of 5%, with 54 patients, this study has an 80% power to detect a disease control rate at one year of 50%.","timeFrame":"12 months"}],"secondaryOutcomes":[{"measure":"Toxicity based on the CTCAE v4.03 criteria","timeFrame":"12 months"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Age \\> 18 ans\n* Patient with metastatic mammary adenocarcinoma\n* Hormone receptors ER and PR positive or negative for HER 2 negative\n\nExclusion Criteria:\n\n* Prior chemotherapy for metastatic disease\n* Previous treatment with eribulin or bevacizumab\n* Presence of symptomatic brain metastases or meningeal","healthyVolunteers":false,"sex":"FEMALE","minimumAge":"18 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"Centre Paul Papin","city":"Angers","country"