{"schemaVersion":1,"nct":"NCT00458601","source":"https://clinicaltrials.gov/study/NCT00458601","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT00458601","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:52:05.475Z","studySha256":"b8eec71d73e2b7aed765c38db3bb6fe0cdbc043479d0cf326e5824567adc4e2b","study":{"protocolSection":{"identificationModule":{"nctId":"NCT00458601","briefTitle":"Phase II Study of Rindopepimut (CDX-110) in Patients With Glioblastoma Multiforme","officialTitle":"A Phase II Study of CDX-110 With Radiation and Temozolomide in Patients With Newly Diagnosed Glioblastoma Multiforme","acronym":"ACT III"},"statusModule":{"statusVerifiedDate":"2016-08","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2007-08"},"primaryCompletionDateStruct":{"date":"2010-11","type":"ACTUAL"},"completionDateStruct":{"date":"2016-05","type":"ACTUAL"},"studyFirstSubmitDate":"2007-04-10","studyFirstSubmitQcDate":"2007-04-10","studyFirstPostDateStruct":{"date":"2007-04-11","type":"ESTIMATED"},"dispFirstSubmitDate":"2010-06-24","dispFirstSubmitQcDate":"2010-07-16","dispFirstPostDateStruct":{"date":"2010-07-20","type":"ESTIMATED"},"lastUpdateSubmitDate":"2018-01-11","lastUpdatePostDateStruct":{"date":"2018-01-16","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Celldex Therapeutics","class":"INDUSTRY"}},"descriptionModule":{"briefSummary":"This study is designed to evaluate the clinical activity of CDX-110 vaccination when given with standard of care treatment (maintenance temozolomide therapy). Study treatment will be given until disease progression and patients will be followed for long-term survival information. Efficacy will be measured by the progression-free survival status at 5.5 months from the date of first dose."},"conditionsModule":{"conditions":["Malignant Glioma"],"keywords":["EGFRvIII vaccinetemozolomidecancer vaccineimmunotherapy"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE2"],"designInfo":{"allocation":"NA","interventionModel":"SINGLE_GROUP","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":82,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"CDX-110 with GM-CSF","type":"EXPERIMENTAL","interventionNames":["Drug: CDX-110 with GM-CSF","Drug: Temozolomide"]}],"interventions":[{"type":"DRUG","name":"CDX-110 with GM-CSF","description":"Three biweekly intradermal injections over four weeks followed by monthly injections until tumor progression. Each dose will be 0.8 mL containing approximately 500 mcg CDX-110 and 150 mcg GM CSF.","armGroupLabels":["CDX-110 with GM-CSF"],"otherNames":["CDX-110 with sargramostim (GM-CSF) (Leukine®)"]},{"type":"DRUG","name":"Temozolomide","description":"Maintenance temozolomide will begin after completion of the three initial injections of CDX-110 plus GM-CSF. 150 to 200 mg/m2 for 5 days during each 28-day cycle for a minimum of six cycles or a maximum of 12 cycles, intolerance or progression.","armGroupLabels":["CDX-110 with GM-CSF"],"otherNames":["Temodar"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Progression-free survival status","timeFrame":"5.5mo"}],"secondaryOutcomes":[{"measure":"Safety and tolerability characterized by adverse events (term, grade, frequency).","timeFrame":"2 years"},{"measure":"Safety and tolerability characterized by physical examinations.","timeFrame":"2 years"},{"measure":"Safety and tolerability characterized by hematologic and metabolic panel (including CBC with differential, electrolytes, BUN, Cr, liver associated enzymes).","timeFrame":"2 years"},{"measure":"Safety and tolerability characterized by urinalysis.","timeFrame":"2 years"},{"measure":"Safety and tolerability characterized by vital signs.","timeFrame":"2 years"},{"measure":"Immune response; T-cell response to vaccine.","timeFrame":"2 years"},{"measure":"Immune response; antibody response to vaccine.","timeFrame":"2 years"},{"measure":"Immune response; HLA typing.","timeFrame":"2 years"},{"measure":"Overall survival.","timeFrame":"indeterminate"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Newly diagnosed de novo GBM with documented EGFRvIII expression in tumor tissue.\n* Gross total resection followed by conventional chemoradiation therapy without progression of disease.\n\nExclusion Criteria:\n\n* Presence of diffuse leptomeningeal disease or gliomatosis cerebri.\n* Systemic corticosteroid therapy \\> 2 mg of dexamethasone or equivalent (as defined by the investigator) per day at study enrollment.\n* Patients who have undergone stereotactic radiosurgery prior to or following surgical resection, or the placement of Gliadel® Wafers.\n* Known allergy or hypersensitivity to KLH, GM-CSF or yeast derived products, or a history of anaphylactic reactions to shellfish proteins.","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"Celldex Investigational Site","city":"Orange","state":"California","zip":"92868","country":"United States","geoPoint":{"lat":33.78779,"lon":-117.85311}},{"facility":"Celldex Investigational Site","city":"San Francisco","state":"California","zip":"94143-0622","country":"United States","geoPoint":{"lat":37.77493,"lon":-122.41942}},{"facility":"Celldex Investigational Site","city":"San Francisco","state":"California","zip":"94143","country":"United States","geoPoint":{"lat":37.77493,"lon":-122.41942}},{"facility":"Celldex Investigational Site","city":"Stanford","state":"California","zip":"94305-5826","country":"United States","geoPoint":{"lat":37.42411,"lon":-122.16608}},{"facility":"Celldex Investigational Site","city":"Stanford","state":"California","zip":"94305","country":"United States","geoPoint":{"lat":37.42411,"lon":-122.16608}},{"facility":"Celldex Investigational Site","city":"New Haven","state":"Connecticut","zip":"