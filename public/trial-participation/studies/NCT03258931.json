{"schemaVersion":1,"nct":"NCT03258931","source":"https://clinicaltrials.gov/study/NCT03258931","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT03258931","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:52:58.985Z","studySha256":"2a765b4f3d9679a7cc72b5ce441e8a17475b584cc721af21239e6ad37fa8e215","study":{"protocolSection":{"identificationModule":{"nctId":"NCT03258931","briefTitle":"Study of Crenolanib vs Midostaurin Following Induction Chemotherapy and Consolidation Therapy in Newly Diagnosed FLT3 Mutated AML","officialTitle":"Phase III Randomized Study of Crenolanib Versus Midostaurin Administered Following Induction Chemotherapy and Consolidation Therapy in Newly Diagnosed Subjects With FLT3 Mutated Acute Myeloid Leukemia"},"statusModule":{"statusVerifiedDate":"2022-04","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2018-08-15","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2026-04-06","type":"ACTUAL"},"completionDateStruct":{"date":"2026-04-06","type":"ACTUAL"},"studyFirstSubmitDate":"2017-08-21","studyFirstSubmitQcDate":"2017-08-21","studyFirstPostDateStruct":{"date":"2017-08-23","type":"ACTUAL"},"lastUpdateSubmitDate":"2026-04-08","lastUpdatePostDateStruct":{"date":"2026-04-09","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Arog Pharmaceuticals, Inc.","class":"INDUSTRY"}},"descriptionModule":{"briefSummary":"A phase III randomized multi-center study designed to compare the efficacy of crenolanib with that of midostaurin when administered following induction chemotherapy, consolidation chemotherapy and bone marrow transplantation in newly diagnosed AML subjects with FLT3 mutation. About 510 subjects will be randomized in a 1:1 ratio to receive either crenolanib in addition to standard first line treatment of AML (chemotherapy and if eligible, transplantation) (arm A) or midostaurin and standard treatment (arm B). Potentially eligible subjects will be registered and tested for the presence of FLT3 mutation. Once the FLT3 mutation status is confirmed and additional eligibility is established, subject will be randomized and enter into the treatment phase."},"conditionsModule":{"conditions":["Newly Diagnosed FLT3 Mutated AML"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"NONE"}},"enrollmentInfo":{"count":214,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Crenolanib","type":"EXPERIMENTAL","description":"Crenolanib following salvage chemotherapy","interventionNames":["Drug: Crenolanib","Drug: Cytarabine","Drug: Duanorubicin"]},{"label":"Midostaurin","type":"ACTIVE_COMPARATOR","description":"Midostaurin following salvage chemotherapy","interventionNames":["Drug: Midostaurin","Drug: Cytarabine","Drug: Duanorubicin"]}],"interventions":[{"type":"DRUG","name":"Crenolanib","description":"Crenolanib will be administered orally","armGroupLabels":["Crenolanib"],"otherNames":["Crenolanib besylate"]},{"type":"DRUG","name":"Midostaurin","description":"Midostaurin will be administered orally","armGroupLabels":["Midostaurin"]},{"type":"DRUG","name":"Cytarabine","description":"100 mg/m² IV continuous infusion over 24 hours","armGroupLabels":["Crenolanib","Midostaurin"]},{"type":"DRUG","name":"Duanorubicin","description":"90 mg/m2 IV","armGroupLabels":["Crenolanib","Midostaurin"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Event-free survival (EFS)","timeFrame":"5 years"}],"secondaryOutcomes":[{"measure":"Overall Survival","timeFrame":"7 years"},{"measure":"Relapse free survival","timeFrame":"5 years"},{"measure":"Composite complete remission rate","timeFrame":"5 years"},{"measure":"Duration of response","timeFrame":"5 years"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Confirmed diagnosis of de novo AML according to World Health Organization (WHO) 2016 classification\n* Presence of FLT3-ITD and/or D835 mutation(s) in bone marrow or peripheral blood\n* Age ≥ 18 years and ≤ 60 years\n* Adequate hepatic function within 48 hours prior to induction chemotherapy\n* Adequate renal functions within 48 hours prior to induction chemotherapy\n* ECOG performance status within 48 hours prior to induction chemotherapy ≤ 3\n* Eligible for intensive cytarabine/daunorubicin (7+3) chemotherapy specified\n\nExclusion Criteria:\n\n* Acute promyelocytic leukemia (APL)\n* Known clinically active central nervous system (CNS) leukemia\n* Severe liver disease\n* Active infections\n* Known, active infection with hepatitis B virus (HBV) or hepatitis C virus (HCV)\n* Known infection with human immunodeficiency virus (HIV)\n* Prior systemic anti-cancer treatment (e.g. chemotherapy, tyrosine kinase inhibitors, immunotherapy, or investigational agents)(except for hydroxyurea and/or leukapheresis)","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","maximumAge":"60 Years","stdAges":["ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"City of Hope National Medical Center","city":"Duarte","state":"California","zip":"91010","country":"United States","geoPoint":{"lat":34.13945,"lon":-117.97729}},{"facility":"Ronald Reagan UCLA Medical Center","city":"Los Angeles","state":"California","zip":"90095","country":"United States","geoPoint":{"lat":34.05223,"lon":-118.24368}},{"facility":"US Davis Health","city":"Sacramento","state":"California","zip":"95817","country":"United States","geoPoint":{"lat":38.58157,"lon":-121.4944}},{"facility":"Yale Cancer Center","city":"New Haven","state":"Connecticut","zip":"06510","country":"United States","geoPoint":{"lat":41.30815,"lon":-72.92816}},{"facility":"Moffitt Cancer Center","city":"Tampa","state":"Florida","zip":"33612","country":"United States","geoPoint":{"lat":27.94752,"lon":-82.45843}},{"facility":"Rush Medical Center","city":"Chicago","state