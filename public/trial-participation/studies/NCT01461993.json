{"schemaVersion":1,"nct":"NCT01461993","source":"https://clinicaltrials.gov/study/NCT01461993","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT01461993","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:52:28.000Z","studySha256":"f72c62ea924cffe95a18f58eddf6813699292c68f15d036f0fdca994fe488695","study":{"protocolSection":{"identificationModule":{"nctId":"NCT01461993","briefTitle":"A Clinical Trial to Study the Safety, Tolerance and Immunogenic Response to Gardasil and Bivalent rLP2086 Vaccine When Given at the Same Time to Children Between the Ages of 11 and 17","officialTitle":"A Phase 2, Randomized, Active-controlled, Observer-blinded Trial, To Assess The Safety, Tolerability, And Immunogenicity Of Gardasil (Registered) (Hpv) Vaccine And Bivalent Rlp2086 Vaccine When Administered Concomitantly In Healthy Subjects Aged >=11 To <18 Years"},"statusModule":{"statusVerifiedDate":"2018-11","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2011-09-28","type":"ACTUAL"},"primaryCompletionDateStruct":{"date":"2013-07-06","type":"ACTUAL"},"completionDateStruct":{"date":"2013-07-06","type":"ACTUAL"},"studyFirstSubmitDate":"2011-09-28","studyFirstSubmitQcDate":"2011-10-26","studyFirstPostDateStruct":{"date":"2011-10-28","type":"ESTIMATED"},"resultsFirstSubmitDate":"2014-11-21","resultsFirstSubmitQcDate":"2014-11-21","resultsFirstPostDateStruct":{"date":"2014-11-26","type":"ESTIMATED"},"dispFirstSubmitDate":"2014-07-25","dispFirstSubmitQcDate":"2014-07-25","dispFirstPostDateStruct":{"date":"2014-07-30","type":"ESTIMATED"},"lastUpdateSubmitDate":"2018-11-30","lastUpdatePostDateStruct":{"date":"2018-12-19","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Pfizer","class":"INDUSTRY"}},"descriptionModule":{"briefSummary":"This is a clinical study to assess the safety, tolerance and immunogenic response to Gardasil (human papilloma virus (HPV)) and rLP2086 vaccine. Healthy male and female subjects will be randomized into 1 of 3 groups; the trial will be an observer-blinded study to the injection being given; and, vaccinated with either Gardasil and rLP2086 concomitantly, rLP2086 and saline concomitantly, or Gardasil and saline concomitantly. The subjects are adolescent children between the ages of 11 and 17 years old."},"conditionsModule":{"conditions":["Vaccines","Meningococcal Vaccines"],"keywords":["vaccine","rLP2086","Gardasil","HPV","meningitis B","N. meningitidis serogroup B","adolescents","single-blind","Meningococcal Vaccines"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE2"],"designInfo":{"allocation":"RANDOMIZED","primaryPurpose":"PREVENTION","maskingInfo":{"masking":"TRIPLE","whoMasked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR"]}},"enrollmentInfo":{"count":2499,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Group 1","type":"ACTIVE_COMPARATOR","description":"rLP2086 + Gardasil","interventionNames":["Biological: rLP2086 and Gardasil"]},{"label":"Group 2","type":"PLACEBO_COMPARATOR","description":"rLP2086 and saline","interventionNames":["Biological: rLP2086"]},{"label":"Group 3","type":"ACTIVE_COMPARATOR","description":"Saline + Gardasil","interventionNames":["Biological: Gardasil"]}],"interventions":[{"type":"BIOLOGICAL","name":"rLP2086 and Gardasil","description":"Gardasil vaccine and rLP2086 injection will be given to the subject concomitantly in Group 1 at Months 0, 2 and 6.","armGroupLabels":["Group 1"]},{"type":"BIOLOGICAL","name":"rLP2086","description":"Injections of rLP2086 and saline will be given to the subject concomitantly in Group 2 at Months 0, 2 and 6.","armGroupLabels":["Group 2"]},{"type":"BIOLOGICAL","name":"Gardasil","description":"Injections of saline and Gardasil vaccine will be given to the subject concomitantly in Group 3 at Months 0, 2 and 6.","armGroupLabels":["Group 3"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Geometric Mean Titer (GMT) of Human Papillomavirus (HPV) Antigens","timeFrame":"1 month after Vaccination 3"},{"measure":"Serum Bactericidal Assay Using Human Complement (hSBA) GMTs of PMB80 [A22] and PMB2948 [B24]","timeFrame":"1 month after Vaccination 3"},{"measure":"Percentage of Participants With at Least One Adverse Event (AE)","timeFrame":"Vaccination 1 up to 1 month after Vaccination 3"}],"secondaryOutcomes":[{"measure":"Percentage of Participants Achieving Seroconversion for Human Papillomavirus (HPV)","timeFrame":"1 month after Vaccination 3"},{"measure":"Percentage of Baseline Seropositive Participants: Group 1 and 3 Participants","timeFrame":"Before vaccination 1"},{"measure":"Percentage of Participants With Serum Bactericidal Assay Using Human Complement (hSBA) Titer Greater Than or Equal to (>=) Lower Limit of Quantitation (LLOQ)","timeFrame":"Before vaccination 1, 1 month after vaccination (Vac) 2, 3"},{"measure":"Percentage of Participants With Serum Bactericidal Assay Using Human Complement (hSBA) Titer >= Prespecified Titer Level","timeFrame":"Before Vaccination 1, 1 month after Vaccination 2, 3"},{"measure":"Serum Bactericidal Assay Using Human Complement (hSBA) Geometric Mean Titer (GMT)","timeFrame":"Before Vaccination 1, 1 month after Vaccination 2, 3"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\n* Male or female subjects from 11 to 17 years old at the time of they start the study.\n* Subject must be healthy which will be determined by obtaining subject's medical history, receiving a physical examination and by judgment of the investigator.\n\nExclusion Criteria:\n\n* Previous vaccination with any meningococcal serogroup B vaccine.\n* Previous vaccination with any HPV vaccine.\n* Contraindication to vaccination with Gardasil or any HPV vaccine.","healthyVolunteers":true,"sex":"ALL","minimumAge":"11 Years","maximumAge":"17 Years","stdAges":["CHILD"]},"contactsLocationsModule":{"locations":[{"facility":"Coastal Clinical Research Inc.","city":"Dap