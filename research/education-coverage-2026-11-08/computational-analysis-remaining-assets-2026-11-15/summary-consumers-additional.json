  "effective": [
    {
      "id": "lead-time-bias",
      "language": "es",
      "available": false,
      "effectiveText": "Finding a cancer earlier starts the survival clock sooner, even if the date of death does not change. Counting that extra time as longer life is lead-time bias. Survival measured from diagnosis alone cannot establish that screening saves lives.",
      "effectiveTextSHA256": "aef21766bf553475f9664610f4f0ccc717d0e30244f7594af8e21337f38b64b9"
    },
