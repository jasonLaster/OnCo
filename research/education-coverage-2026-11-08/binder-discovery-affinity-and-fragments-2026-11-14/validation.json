      {
        "recordId": "binder-discovery",
        "field": "asOf",
        "before": "2026-11-10",
        "beforeSha256": "f67c5ec50bf3ce9b5e2e30b3b2ba5789ee3f1491778fd8b3b94147e12dbc2a81",
