hases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"QUADRUPLE","whoMasked":["PARTICIPANT","CARE_PROVIDER","INVESTIGATOR","OUTCOMES_ASSESSOR"]}},"enrollmentInfo":{"count":587,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"Brivanib","type":"EXPERIMENTAL","interventionNames":["Drug: Brivanib","Procedure: Best Supportive Care"]},{"label":"Placebo","type":"PLACEBO_COMPARATOR","interventionNames":["Other: Placebo","Procedure: Best Supportive Care"]}],"interventions":[{"type":"DRUG","name":"Brivanib","description":"Tablets, Oral, 800 mg, once daily, until disease progression or toxicity","armGroupLabels":["Brivanib"],"otherNames":["BMS-582664"]},{"type":"OTHER","name":"Placebo","description":"Tablets, Oral, 0 mg, once daily, until disease progression or toxicity","armGroupLabels":["Placebo"]},{"type":"PROCEDURE","name":"Best Supportive Care","description":"Trans-Arterial Chemo-Embolization (TACE) Therapy","armGroupLabels":["Brivanib","Placebo"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"To compare overall survival of subjects with advanced HCC who have progressed on/after or are intolerant to Sorafenib and receive Brivanib plus best supportive care (BSC) to those receiving placebo plus BSC","timeFrame":"computerized tomography (CT)/ magnetic resonance imaging (MRI) every six weeks until progression or death"}],"secondaryOutcomes":[{"measure":"To compare time to progression (TTP) (Investigator assessed using modified Response Evaluation Criteria In Solid Tumors (RECIST) for HCC criteria)","timeFrame":"35 months"},{"measure":"To compare the Independent Radiological Review Committee (IRRC) assessed objective response rate (ORR) and disease control rate (DCR) using modified RECIST for HCC criteria","timeFrame":"35 months"},{"measure":"To assess duration of response, duration of disease control and time to response","timeFrame":"6 weeks"},{"measure":"To asse