{"schemaVersion":1,"nct":"NCT00130676","source":"https://clinicaltrials.gov/study/NCT00130676","apiSource":"https://clinicaltrials.gov/api/v2/studies/NCT00130676","attribution":"Courtesy of the National Library of Medicine","fetchedAt":"2026-10-07T16:51:56.584Z","studySha256":"cffe839655d46090a7fbe2623ca84e3839b94e1bf0b3698bec589e8444abd32c","study":{"protocolSection":{"identificationModule":{"nctId":"NCT00130676","briefTitle":"A United States Study of Corlux for Psychotic Symptoms in Psychotic Major Depression","officialTitle":"A Randomized, Double-Blind, Placebo-Controlled Study of Safety and Efficacy of CORLUX™ (Mifepristone) in the Treatment of Psychotic Symptoms in Patients With Major Depressive Disorder With Psychotic Features"},"statusModule":{"statusVerifiedDate":"2012-02","overallStatus":"COMPLETED","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2004-09"},"primaryCompletionDateStruct":{"date":"2006-06","type":"ACTUAL"},"completionDateStruct":{"date":"2006-06","type":"ACTUAL"},"studyFirstSubmitDate":"2005-08-12","studyFirstSubmitQcDate":"2005-08-12","studyFirstPostDateStruct":{"date":"2005-08-16","type":"ESTIMATED"},"lastUpdateSubmitDate":"2012-02-14","lastUpdatePostDateStruct":{"date":"2012-02-15","type":"ESTIMATED"}},"sponsorCollaboratorsModule":{"leadSponsor":{"name":"Corcept Therapeutics","class":"INDUSTRY"}},"descriptionModule":{"briefSummary":"Corlux (mifepristone) is a new medication that modulates the body's use of a hormone called cortisol. Under normal conditions, cortisol and other hormones are created by the body in response to physical and emotional stress, triggering a healthy stress response. People who suffer from psychotic major depression may have unusually high levels of cortisol circulating within them or abnormal patterns of cortisol levels, overloading the stress response mechanism and causing symptoms of psychosis such as delusional thoughts or hallucinations. If Corlux can keep the body's cortisol receptors from being overloaded, the stress response system may return to normal function, which may result in improvement of symptoms. The purpose of this 56 day study is to learn the safety and effectiveness of Corlux in patients who have been diagnosed with psychotic major depression (PMD)."},"conditionsModule":{"conditions":["Major Depressive Disorder","Psychotic Disorders"],"keywords":["PMD","Psychotic Major Depression","Depression","Major Depression","Psychosis"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["PHASE3"],"designInfo":{"allocation":"RANDOMIZED","interventionModel":"PARALLEL","primaryPurpose":"TREATMENT","maskingInfo":{"masking":"DOUBLE","whoMasked":["PARTICIPANT","INVESTIGATOR"]}},"enrollmentInfo":{"count":257,"type":"ACTUAL"}},"armsInterventionsModule":{"armGroups":[{"label":"mifepristone 600 mg","type":"EXPERIMENTAL","interventionNames":["Drug: Mifepristone"]},{"label":"matching placebo","type":"PLACEBO_COMPARATOR","interventionNames":["Drug: matching placebo"]}],"interventions":[{"type":"DRUG","name":"Mifepristone","description":"daily for 7 days","armGroupLabels":["mifepristone 600 mg"]},{"type":"DRUG","name":"matching placebo","description":"daily for 7 days","armGroupLabels":["matching placebo"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"The change in a measure of psychosis","timeFrame":"screening and on Days 0, 7, 14, 28, 42, and 56"}],"secondaryOutcomes":[{"measure":"The change in a measure of depression","timeFrame":"screening and on Days 0, 7, 14, 28, 42, and 56"}]},"eligibilityModule":{"eligibilityCriteria":"Inclusion Criteria:\n\nIndividuals eligible for enrollment into this study are male and female adult patients who:\n\n* Are 18 to 75 years of age\n* Have a diagnosis of major depressive disorder with psychotic features (DSM-IV 296.24 or 296.34)\n* Are able to provide written informed consent\n\nExclusion Criteria:\n\nIndividuals not eligible to be enrolled into the study are those who:\n\n* Have a major medical problem\n* Have previously participated in a Corlux (C-1073, mifepristone) clinical trial\n* Have a history of an allergic reaction to Corlux (C-1073, mifepristone)","healthyVolunteers":false,"sex":"ALL","minimumAge":"18 Years","maximumAge":"75 Years","stdAges":["ADULT","OLDER_ADULT"]},"contactsLocationsModule":{"locations":[{"facility":"CNRI-LA","city":"Pico Rivera","state":"California","zip":"90660","country":"United States","geoPoint":{"lat":33.98307,"lon":-118.09673}},{"facility":"Behavioral Health 2000, LLC","city":"Riverside","state":"California","zip":"92506","country":"United States","geoPoint":{"lat":33.95335,"lon":-117.39616}},{"facility":"Cnri, Llc","city":"San Diego","state":"California","zip":"92126","country":"United States","geoPoint":{"lat":32.71571,"lon":-117.16472}},{"facility":"University of Florida Clinical Trials","city":"Jacksonville","state":"Florida","zip":"32257","country":"United States","geoPoint":{"lat":30.33218,"lon":-81.65565}},{"facility":"Quantum Laboratories/Memory Disorder Center","city":"Pompano Beach","state":"Florida","zip":"33064","country":"United States","geoPoint":{"lat":26.23786,"lon":-80.12477}},{"facility":"Atlanta Center for Medical Research","city":"Atlanta","state":"Georgia","zip":"30308","country":"United States","geoPoint":{"lat":33.749,"lon":-84.38798}},{"facility":"American Medical Research, Inc.","city":"Oak Brook","state":"Illinois","zip":"60523","country":"United States","geoPoint":{"lat":41.83281,"lon":-87.92895}},{"facility":"Valle Vista Health System","city":"Greenwood","state":"Indiana","zip":"46143","country":"United States","geoPoint":{"lat":39.61366,"lon":-86.10665}},{"facility":"Psychopharmacology Research","city":"Farmington Hills","state":"Michigan","zip":"48334","country":"United States","geoPoint":{"lat":42.48531,"lon":-83.37716}},{"facility":"Robert Horne, MD","city":"Las Vegas","state":"Nevada","zip":"89102","country":"United States","geoPoint":{"lat":36.17497,"lon":-115.13722}},{"facility":"CNS Research Inst