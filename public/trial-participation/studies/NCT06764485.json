Names":["Drug: Enzalutamide","Drug: Abiraterone","Drug: Predinsone/Prednisolone"]},{"label":"Part 2: Comparator 2","type":"ACTIVE_COMPARATOR","interventionNames":["Drug: Docetaxel","Drug: Predinsone/Prednisolone"]}],"interventions":[{"type":"DRUG","name":"BMS-986365","description":"Specified dose on specified days","armGroupLabels":["Part 1: Dose 1","Part 1: Dose 2","Part 2: Dose Selected"]},{"type":"DRUG","name":"Enzalutamide","description":"Specified dose on specified days","armGroupLabels":["Part 1: Comparator 1","Part 2: Comparator 1"]},{"type":"DRUG","name":"Abiraterone","description":"Specified dose on specified days","armGroupLabels":["Part 1: Comparator 1","Part 2: Comparator 1"]},{"type":"DRUG","name":"Docetaxel","description":"Specified dose on specified days","armGroupLabels":["Part 1: Comparator 2","Part 2: Comparator 2"]},{"type":"DRUG","name":"Predinsone/Prednisolone","description":"Specified dose on specified days","armGroupLabels":["Part 1: Comparator 1","Part 1: Comparator 2","Part 2: Comparator 1","Part 2: Comparator 2"]}]},"outcomesModule":{"primaryOutcomes":[{"measure":"Radiographic progression-free survival (rPFS) by blinded independent central review (BICR) using Response Evaluation Criteria in Solid Tumors (RECIST) 1.1 (soft tissue) and Prostate Cancer Clinical Trials Working Group 3 (PCWG3) (bone) criteria","timeFrame":"Up to 4 years"}],"secondaryOutcomes":[{"measure":"Overall Survival (OS)","timeFrame":"Up to 4 years"},{"measure":"Recommended dose of BMS-986365 for Part 2","timeFrame":"Up to approximately 1.5 years"},{"measure":"Progression-free survival (PFS)","timeFrame":"Up to 4 years"},{"measure":"Confirmed overall response rate (ORR) by BICR assessment in participants with measurable disease using RECIST 1.1 (soft tissue) and PCWG3 (bone) criteria","timeFrame":"Up to 4 years"},{"measure":"Time to pain progression (TTPP)","timeFrame":"Up to 4 years"},{"measure":"Time to symptomatic progression (TTSP)","timeFrame":"Up to 4 years"},{"measu